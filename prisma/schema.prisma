enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Actionable follow-up work. "Overdue" is a derived state (dueAt in the
/// past AND status not COMPLETED/CANCELLED), not a stored column — the
/// (organizationId, status, dueAt) index exists to make that derivation
/// cheap at query time.
model Task {
  id                     String       @id @default(uuid())
  organizationId         String       @map("organization_id")
  title                  String
  description            String?
  /// Client requirements as a snapshot taken when the task was created (FIG-1038); what a Restricted Technical user works from.
  requirements           String?
  assigneeMembershipId   String       @map("assignee_membership_id")
  createdByMembershipId  String       @map("created_by_membership_id")
  dueAt                  DateTime?    @map("due_at")
  priority               TaskPriority @default(MEDIUM)
  status                 TaskStatus   @default(PENDING)
  completedAt            DateTime?    @map("completed_at")
  archivedAt             DateTime?    @map("archived_at")
  archivedByMembershipId String?      @map("archived_by_membership_id")
  archiveReason          String?      @map("archive_reason")
  companyId              String?      @map("company_id")
  contactId              String?      @map("contact_id")
  leadId                 String?      @map("lead_id")
  dealId                 String?      @map("deal_id")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     Membership   @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Restrict)
  createdBy    Membership   @relation("TaskCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  attachments     Attachment[]
  comments        Comment[]
  follows         RecordFollow[]
  /// B4.04: the import session that created this row (null for rows made any other way).
  importSessionId String?        @map("import_session_id")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, assigneeMembershipId, status])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
  /// Follow-up-performance reporting (FIG-603) scans by organizationId +
  /// a dueAt range (owner filter is optional) before grouping by status.
  @@index([organizationId, dueAt])
  @@index([organizationId, archivedAt])
  @@map("tasks")
}

enum CommunicationChannel {
  EMAIL
  PHONE
  WHATSAPP
  SMS
  MEETING
  SOCIAL
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

/// Channel-specific interaction detail. May optionally point at the
/// Activity timeline entry it corresponds to, avoiding duplicate parallel
/// histories.
model Communication {
  id                      String                 @id @default(uuid())
  organizationId          String                 @map("organization_id")
  channel                 CommunicationChannel
  direction               CommunicationDirection
  occurredAt              DateTime               @default(now()) @map("occurred_at")
  subject                 String?
  summary                 String
  externalReference       String?                @map("external_reference")
  /// Null for an inbound communication logged by the webhook in
  /// `src/services/inboundEmailService.ts` (FIG-598) -- there is no CRM
  /// user to attribute it to. Every other create path (manual log, "send
  /// and log email") always stamps the caller's own membership.
  authorMembershipId      String?                @map("author_membership_id")
  activityId              String?                @map("activity_id")
  /// The template this email started from (FIG-797); kept as null if the template is deleted.
  emailTemplateId         String?                @map("email_template_id")
  companyId               String?                @map("company_id")
  contactId               String?                @map("contact_id")
  leadId                  String?                @map("lead_id")
  dealId                  String?                @map("deal_id")
  /// A message that matched no record waits in the Needs-linking queue (FIG-1053).
  needsLinking            Boolean                @default(false) @map("needs_linking")
  counterpartyEmail       String?                @map("counterparty_email")
  counterpartyName        String?                @map("counterparty_name")
  counterpartyPhone       String?                @map("counterparty_phone")
  durationSeconds         Int?                   @map("duration_seconds")
  linkedAt                DateTime?              @map("linked_at")
  linkedByMembershipId    String?                @map("linked_by_membership_id")
  dismissedAt             DateTime?              @map("dismissed_at")
  dismissedByMembershipId String?                @map("dismissed_by_membership_id")
  dismissReason           String?                @map("dismiss_reason")
  createdAt               DateTime               @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Membership?  @relation("CommunicationAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  activity     Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  emailTemplate EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, companyId, occurredAt])
  @@index([organizationId, contactId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@index([organizationId, channel])
