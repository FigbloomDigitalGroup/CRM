}

model ImportSessionChange {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id")
  entity         String
  recordId       String   @map("record_id")
  action         String
  previous       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId], map: "import_session_changes_session_idx")
  @@map("import_session_changes")
}

/// A request from a person about their own data (B4.05, Kenya DPA). Closed rows carry no personal details.
model DataSubjectRequest {
  id                            String    @id @default(uuid())
  organizationId                String    @map("organization_id")
  kind                          String
  status                        String    @default("OPEN")
  contactId                     String?   @map("contact_id")
  subjectLabel                  String    @map("subject_label")
  dueOn                         DateTime  @map("due_on") @db.Date
  evidenceNotes                 String?   @map("evidence_notes")
  requestedByMembershipId       String?   @map("requested_by_membership_id")
  firstConfirmedByMembershipId  String?   @map("first_confirmed_by_membership_id")
  firstConfirmedAt              DateTime? @map("first_confirmed_at")
  secondConfirmedByMembershipId String?   @map("second_confirmed_by_membership_id")
  secondConfirmedAt             DateTime? @map("second_confirmed_at")
  result                        Json?
  exportFileId                  String?   @map("export_file_id")
  completedAt                   DateTime? @map("completed_at")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("data_subject_requests")
}

/// A Management decision that lets one bulk export above the row threshold run (B4.05).
model ExportApproval {
  id                      String    @id @default(uuid())
  organizationId          String    @map("organization_id")
  entity                  String
  filters                 Json      @default("{}")
  rowCount                Int       @map("row_count")
  reason                  String?
  status                  String    @default("PENDING")
  requestedByMembershipId String    @map("requested_by_membership_id")
  decidedByMembershipId   String?   @map("decided_by_membership_id")
  decidedAt               DateTime? @map("decided_at")
  decisionNote            String?   @map("decision_note")
  expiresAt               DateTime? @map("expires_at")
  usedAt                  DateTime? @map("used_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("export_approvals")
}

/// One queued change from a phone or the PWA, and what the server did with it (B4.07). Replaying a client id returns this row.
model SyncMutation {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  membershipId    String    @map("membership_id")
  clientId        String    @map("client_id")
  kind            String
  status          String
  reason          String?
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  response        Json?
  requestHash     String    @map("request_hash")
  clientCreatedAt DateTime? @map("client_created_at")
  batchId         String?   @map("batch_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, clientId], map: "sync_mutations_org_member_client_key")
  @@map("sync_mutations")
}

/// A browser or phone that can receive Web Push for one membership (B4.07).
model PushSubscription {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  membershipId   String    @map("membership_id")
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  lastFailureAt  DateTime? @map("last_failure_at")
  failureCount   Int       @default(0) @map("failure_count")
  revokedAt      DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, endpoint], map: "push_subscriptions_org_member_endpoint_key")
  @@map("push_subscriptions")
}
