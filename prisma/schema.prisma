}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Proposal/quotation *reference* only — no document generation or
/// e-signature flow.
model ProposalReference {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  dealId            String         @map("deal_id")
  proposalNumber    String         @map("proposal_number")
  status            ProposalStatus @default(DRAFT)
  amount            Decimal?       @db.Decimal(14, 2)
  currency          String         @default("KES")
  ownerMembershipId String?        @map("owner_membership_id")
  sentAt            DateTime?      @map("sent_at")
  respondedAt       DateTime?      @map("responded_at")
  documentReference String?        @map("document_reference")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("ProposalOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dealId, proposalNumber])
  @@index([organizationId])
  @@index([organizationId, dealId])
  @@index([organizationId, status])
  @@map("proposal_references")
}

enum CompanyServiceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Tracks which services a Company has/had, independent of any single
/// Deal — supports a customer holding multiple services at once, and
/// future renewal/retainer reporting.
model CompanyService {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  companyId      String               @map("company_id")
  serviceId      String               @map("service_id")
  status         CompanyServiceStatus @default(ACTIVE)
  startDate      DateTime?            @map("start_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, serviceId, status])
  @@map("company_services")
}

// ---------------------------------------------------------------------------
// 5. Governance
// ---------------------------------------------------------------------------

/// Append-only. organizationId is nullable to allow platform-level events
/// (e.g. organization provisioning) that precede any organization-scoped
/// action; ordinary business-record events always carry it. Immutability
/// (no UPDATE/DELETE for the application role) is enforced via a REVOKE in
/// the tenant-integrity migration, not just by omitting an updatedAt
/// column here.
model AuditEvent {
  id                String   @id @default(uuid())
  organizationId    String?  @map("organization_id")
  actorUserId       String?  @map("actor_user_id")
  actorMembershipId String?  @map("actor_membership_id")
  action            String
  entityType        String   @map("entity_type")
  entityId          String?  @map("entity_id")
  previousValue     Json?    @map("previous_value")
  newValue          Json?    @map("new_value")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser       User?         @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorMembershipId])
  @@map("audit_events")
}

enum ScheduledJobStatus {
  IDLE
  RUNNING
}

/// Tracks a recurring background job's run state across the whole
/// deployment (FIG-783) -- currently just the notifications due/overdue
/// sweep (`scheduledJobRuns.ts`, `notificationSweepService.ts`). One row
/// per `jobKey`, claimed by a single atomic `UPDATE ... WHERE status =
/// 'IDLE' ...` (Postgres serializes concurrent UPDATEs touching the same
/// row, so only one caller's statement can ever flip it to `RUNNING`),
/// which is what stops two overlapping triggers of the same job -- an
/// external cron firing twice, two replicas each wired to the same
/// schedule -- from both running at once and double-sending.
/// Global/operational state, not tenant business data: no
/// `organizationId`, and deliberately outside the row-level-security
/// scheme added in `*_tenant_integrity_and_rls` (RLS there is applied to
/// an explicit, named list of tables -- a table simply absent from that
/// list has none, which is correct here).
model ScheduledJobRun {
  id          String             @id @default(uuid())
  jobKey      String             @unique @map("job_key")
  status      ScheduledJobStatus @default(IDLE)
  startedAt   DateTime?          @map("started_at")
  completedAt DateTime?          @map("completed_at")
  lastError   String?            @map("last_error")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("scheduled_job_runs")
}

enum AuthRateLimitAction {
  LOGIN
  SIGNUP
  PASSWORD_RESET
  WEBSITE_LEAD
  INVITE_ACCEPT
  PASSWORD_RESET_CONFIRM
  INBOUND_EMAIL
}

/// Durable, cross-instance rate-limit counter (FIG-784) shared by every
/// public, pre-session endpoint: login, signup, password-reset request,
/// and the website lead-capture endpoint (replacing that one's own
/// `WebsiteLeadRequestLog`-based counting, see that model's doc comment --
/// `WebsiteLeadRequestLog` keeps writing its own richer per-org monitoring
/// log independently; this table exists purely to decide "has this
/// IP/email/key made too many attempts recently," nothing else reads it).
///
/// One row per (action, scope, key) per attempt -- e.g. a single login
/// attempt writes two rows, `("LOGIN", "ip", "203.0.113.1")` and
/// `("LOGIN", "email", "alice@example.com")` -- counted over a sliding
/// window (`src/auth/rateLimiter.ts`). Never aggregated or deleted, so this
/// grows unbounded over time -- same accepted tradeoff as
/// `WebsiteLeadRequestLog`, no retention job exists for either.
///
/// No organizationId, no RLS: every one of these endpoints runs before any
/// org/session context exists, so every access (the write AND the
/// count-based read) goes through the schema-owner `adminDb` connection,
/// never the RLS-scoped app role -- which has no need for this table at
/// all and has every privilege on it revoked outright (see
/// `scripts/db-admin.ts#grantRole` and this migration), since there's no
/// tenant column here for RLS to filter by in the first place.
model AuthRateLimitAttempt {
  id        String              @id @default(uuid())
  action    AuthRateLimitAction
  scope     String
  key       String
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([action, scope, key, createdAt])
  @@map("auth_rate_limit_attempts")
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED
}

/// One unit of background work (FIG-1066, B2.18): an import, a lifecycle
/// pass, a reminder sweep. Every job belongs to an organisation. A worker
/// claims a job with a lease; a crashed worker's lease expires and the job is
/// picked up again, so work is never lost, and a result is only recorded by
/// the worker that still holds the lease, so it is never applied twice.
/// `DEAD` is the dead-letter state: attempts used up, kept for inspection.
model BackgroundJob {
  id                    String              @id @default(uuid())
  organizationId        String              @map("organization_id")
  type                  String
  payload               Json                @default("{}")
  status                BackgroundJobStatus @default(QUEUED)
  attempts              Int                 @default(0)
  maxAttempts           Int                 @default(5) @map("max_attempts")
  runAt                 DateTime            @default(now()) @map("run_at")
  timeoutMs             Int                 @default(300000) @map("timeout_ms")
  lockedBy              String?             @map("locked_by")
  leaseExpiresAt        DateTime?           @map("lease_expires_at")
  startedAt             DateTime?           @map("started_at")
  finishedAt            DateTime?           @map("finished_at")
  lastError             String?             @map("last_error")
  result                Json?
  dedupeKey             String?             @map("dedupe_key")
  requestId             String?             @map("request_id")
  createdByMembershipId String?             @map("created_by_membership_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey], map: "background_jobs_org_dedupe_key")
  @@index([status, runAt], map: "background_jobs_claim_idx")
  @@index([organizationId, status, createdAt], map: "background_jobs_org_status_idx")
  @@index([organizationId, type, createdAt], map: "background_jobs_org_type_idx")
  @@map("background_jobs")
}

/// What a company or contact merge moved (FIG-1033, B2.04), kept so the merge
/// can be undone for a short period (`undoExpiresAt`). The loser is archived,
/// never deleted, whether or not the merge is undone.
model MergeRecord {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  entityType           String    @map("entity_type")
  winnerId             String    @map("winner_id")
  loserId              String    @map("loser_id")
  mergedByMembershipId String?   @map("merged_by_membership_id")
  mergedAt             DateTime  @default(now()) @map("merged_at")
  undoExpiresAt        DateTime  @map("undo_expires_at")
  undoneAt             DateTime? @map("undone_at")
  undoneByMembershipId String?   @map("undone_by_membership_id")
  /// Ids re-pointed per table, and the winner's and loser's field values before the merge.
  snapshot             Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, mergedAt])
  @@index([organizationId, loserId])
  @@map("merge_records")
}

enum CustomFieldEntity {
  LEAD
  CONTACT
  COMPANY
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

enum CustomFieldSection {
  GENERAL
  QUALIFICATION
}

/// A field an organisation adds to leads, contacts, companies or deals
/// (FIG-803), or a per-service qualification question (FIG-1030, B2.01:
/// `section = QUALIFICATION`, optionally tied to one service). Values are
/// validated against these definitions on every write.
model CustomFieldDefinition {
  id                String             @id @default(uuid())
  organizationId    String             @map("organization_id")
  entityType        CustomFieldEntity  @map("entity_type")
  section           CustomFieldSection @default(GENERAL)
  key               String
  label             String
  fieldType         CustomFieldType    @default(TEXT) @map("field_type")
  options           Json?
  helpText          String?            @map("help_text")
  required          Boolean            @default(false)
  requiredOnQualify Boolean            @default(false) @map("required_on_qualify")
  serviceId         String?            @map("service_id")
  sortOrder         Int                @default(0) @map("sort_order")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, key], map: "custom_field_definitions_org_entity_key_key")
  @@unique([organizationId, id], map: "custom_field_definitions_organization_id_id_key")
  @@index([organizationId, entityType, isActive, sortOrder], map: "custom_field_definitions_org_entity_active_idx")
  @@map("custom_field_definitions")
}

/// An organisation's tag (FIG-798). Names are unique per organisation without
/// regard to case. Linked to records through `TagLink`.
model Tag {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  name                  String
  colour                String   @default("forest")
  /// B4.06: a hidden tag stays on the records that carry it and leaves the pickers.
  isActive              Boolean  @default(true) @map("is_active")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links        TagLink[]

  @@map("tags")
}

/// One tag on one record: exactly one of the four record columns is set.
model TagLink {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  tagId                 String   @map("tag_id")
  companyId             String?  @map("company_id")
  contactId             String?  @map("contact_id")
  leadId                String?  @map("lead_id")
  dealId                String?  @map("deal_id")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("tag_links")
}

/// A file attached to a company, contact, lead, deal or task (FIG-796). The
/// bytes are described by the `File` row; this says which record it belongs to
/// and whether it is shared with everyone who can open that record. Exactly one
/// record column is set.
model Attachment {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  fileId                 String    @unique @map("file_id")
  companyId              String?   @map("company_id")
  contactId              String?   @map("contact_id")
  leadId                 String?   @map("lead_id")
  dealId                 String?   @map("deal_id")
  taskId                 String?   @map("task_id")
  proposalReferenceId    String?   @map("proposal_reference_id")
  title                  String?
  /// Files on a deal are visible only to people who may see deal values, unless shared.
  shared                 Boolean   @default(true)
  uploadedByMembershipId String?   @map("uploaded_by_membership_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  deletedAt              DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

/// A reusable email (FIG-797): subject and body with merge fields such as
/// {{contact.firstName}}. Managed in Settings (`templates.manage`).
model EmailTemplate {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  name                  String
  subject               String
  body                  String
  isActive              Boolean  @default(true) @map("is_active")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communications Communication[]

  @@map("email_templates")
}

enum LeadPoolRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  SUPERSEDED
}

/// A request to take an unassigned lead from the shared pool (FIG-1031, B2.02).
model LeadPoolRequest {
  id                    String                @id @default(uuid())
  organizationId        String                @map("organization_id")
  leadId                String                @map("lead_id")
  requesterMembershipId String                @map("requester_membership_id")
  status                LeadPoolRequestStatus @default(PENDING)
  note                  String?
  decisionReason        String?               @map("decision_reason")
  decidedByMembershipId String?               @map("decided_by_membership_id")
  decidedAt             DateTime?             @map("decided_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@map("lead_pool_requests")
}

/// One move of a deal between pipeline stages (FIG-1035), kept so it can be
/// undone for a short period. `previous` holds the outcome fields before it.
model DealMove {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  dealId              String    @map("deal_id")
  fromStageId         String    @map("from_stage_id")
  toStageId           String    @map("to_stage_id")
  movedByMembershipId String?   @map("moved_by_membership_id")
  movedAt             DateTime  @default(now()) @map("moved_at")
  undoExpiresAt       DateTime  @map("undo_expires_at")
  undoneAt            DateTime? @map("undone_at")
  previous            Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, dealId, movedAt])
  @@map("deal_moves")
}

enum HandoffStatus {
  AWAITING_OWNER
  ONBOARDING
  DELIVERED
}

/// What a member searched for recently (FIG-1041); the newest few are shown under the search box.
model SearchRecent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  membershipId   String   @map("membership_id")
  query          String
  lastUsedAt     DateTime @default(now()) @map("last_used_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId, lastUsedAt(sort: Desc)], map: "search_recents_member_used_idx")
  @@map("search_recents")
}

/// A comment on one record (FIG-1044): exactly one of the five record columns is set.
/// Edits and deletes are soft; a deleted comment keeps its row but loses its text.
model Comment {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  companyId             String?   @map("company_id")
  contactId             String?   @map("contact_id")
  leadId                String?   @map("lead_id")
  dealId                String?   @map("deal_id")
  taskId                String?   @map("task_id")
  authorMembershipId    String?   @map("author_membership_id")
  body                  String
  editedAt              DateTime? @map("edited_at")
  deletedAt             DateTime? @map("deleted_at")
  deletedByMembershipId String?   @map("deleted_by_membership_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions     CommentMention[]

  @@map("comments")
}

/// Who a comment mentioned, so an edit notifies only the newly mentioned.
model CommentMention {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  commentId      String   @map("comment_id")
  membershipId   String   @map("membership_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comment      Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, membershipId])
  @@map("comment_mentions")
}

/// A member following a record to hear about its new comments (FIG-1044).
model RecordFollow {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  membershipId   String   @map("membership_id")
  companyId      String?  @map("company_id")
  contactId      String?  @map("contact_id")
  leadId         String?  @map("lead_id")
  dealId         String?  @map("deal_id")
  taskId         String?  @map("task_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("record_follows")
}

enum DataRunKind {
  IMPORT
  EXPORT
}

enum DataRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

/// An import or export a person started (FIG-1034). The work is a background job; this row is what they watch.
model DataRun {
  id                    String        @id @default(uuid())
  organizationId        String        @map("organization_id")
  kind                  DataRunKind
  entity                String
  status                DataRunStatus @default(QUEUED)
  createdByMembershipId String?       @map("created_by_membership_id")
  sourceFileId          String?       @map("source_file_id")
  resultFileId          String?       @map("result_file_id")
  errorFileId           String?       @map("error_file_id")
  params                Json          @default("{}")
  totalRows             Int           @default(0) @map("total_rows")
  processedRows         Int           @default(0) @map("processed_rows")
  createdRows           Int           @default(0) @map("created_rows")
  duplicateRows         Int           @default(0) @map("duplicate_rows")
  alreadyConvertedRows  Int           @default(0) @map("already_converted_rows")
  failedRows            Int           @default(0) @map("failed_rows")
  truncated             Boolean       @default(false)
  cancelRequested       Boolean       @default(false) @map("cancel_requested")
  failureMessage        String?       @map("failure_message")
  jobId                 String?       @map("job_id")
  startedAt             DateTime?     @map("started_at")
  finishedAt            DateTime?     @map("finished_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)], map: "data_runs_org_created_idx")
  @@map("data_runs")
}

/// The last computed dashboard signals for an organisation (FIG-1043): adoption, stalled deals, overdue tasks.
model SignalSnapshot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          Json
  computedAt     DateTime @map("computed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("signal_snapshots")
}

// ---------------------------------------------------------------------------
// Stage 3: payments tracker, recurring services, lifecycle history
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  VOID
}

/// An invoice or expected payment (FIG-1049). Status only: nothing is processed and no bank details are stored.
/// "Overdue" is derived from the due date and the unpaid balance, never stored.
model Invoice {
  id                    String        @id @default(uuid())
  organizationId        String        @map("organization_id")
  dealId                String?       @map("deal_id")
  companyId             String        @map("company_id")
  number                String
  amount                Decimal       @db.Decimal(14, 2)
  currency              String        @default("KES")
  issuedOn              DateTime      @map("issued_on") @db.Date
  dueOn                 DateTime      @map("due_on") @db.Date
  status                InvoiceStatus @default(DRAFT)
  /// Set when a person explicitly accepts payments above the invoice amount.
  allowOverpayment      Boolean       @default(false) @map("allow_overpayment")
  voidedAt              DateTime?     @map("voided_at")
  voidReason            String?       @map("void_reason")
  voidedByMembershipId  String?       @map("voided_by_membership_id")
  recurringServiceId    String?       @map("recurring_service_id")
  notes                 String?
  createdByMembershipId String?       @map("created_by_membership_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recurringService RecurringService? @relation(fields: [recurringServiceId], references: [id], onDelete: SetNull)
  payments         PaymentRecord[]

  @@unique([organizationId, id])
  @@index([organizationId, status, dueOn])
  @@index([organizationId, dealId])
  @@index([organizationId, companyId])
  @@map("invoices")
}

/// Money received against an invoice. Append-only: a mistake is reversed with a reason, never deleted.
model PaymentRecord {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  invoiceId              String    @map("invoice_id")
  amount                 Decimal   @db.Decimal(14, 2)
  paidOn                 DateTime  @map("paid_on") @db.Date
  methodLabel            String?   @map("method_label")
  reference              String?
  recordedByMembershipId String?   @map("recorded_by_membership_id")
  reversedAt             DateTime? @map("reversed_at")
  reversalReason         String?   @map("reversal_reason")
  reversedByMembershipId String?   @map("reversed_by_membership_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paidOn])
  @@map("payment_records")
}

/// The one "next" follow-up note Finance keeps on a won deal, with who owns it and when (FIG-1049, departure 1.5).
model DealPaymentNote {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  dealId                String    @map("deal_id")
  note                  String
  ownerMembershipId     String?   @map("owner_membership_id")
  nextOn                DateTime? @map("next_on") @db.Date
  updatedByMembershipId String?   @map("updated_by_membership_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dealId])
  @@map("deal_payment_notes")
}

enum RecurringBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RenewalState {
  ACTIVE
  DUE_SOON
  LAPSED
  STARTS_LATER
  CANCELLED
}

/// A service that renews on a date (hosting, Starlink plans, retainers) (FIG-1051). The renewal state is derived from
/// the dates by rule; `stateOverride` is a person's decision and always has a reason.
model RecurringService {
  id                    String                @id @default(uuid())
  organizationId        String                @map("organization_id")
  companyId             String                @map("company_id")
  serviceId             String                @map("service_id")
  companyServiceId      String?               @map("company_service_id")
  billingCycle          RecurringBillingCycle @default(YEARLY) @map("billing_cycle")
  value                 Decimal?              @db.Decimal(14, 2)
  currency              String                @default("KES")
  startsOn              DateTime              @map("starts_on") @db.Date
  renewsOn              DateTime              @map("renews_on") @db.Date
  ownerMembershipId     String?               @map("owner_membership_id")
  autoRenew             Boolean               @default(false) @map("auto_renew")
  cancelledAt           DateTime?             @map("cancelled_at")
  cancelReason          String?               @map("cancel_reason")
  stateOverride         RenewalState?         @map("state_override")
  overrideReason        String?               @map("override_reason")
  lastRenewedAt         DateTime?             @map("last_renewed_at")
  notes                 String?
  createdByMembershipId String?               @map("created_by_membership_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@unique([organizationId, id])
  @@index([organizationId, renewsOn])
  @@index([organizationId, companyId])
  @@index([organizationId, ownerMembershipId])
  @@map("recurring_services")
}

/// One row per lifecycle state change of a company: shown on the timeline and kept as history (FIG-1048).
model LifecycleEvent {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  companyId         String   @map("company_id")
  fromStateId       String?  @map("from_state_id")
  toStateId         String   @map("to_state_id")
  /// LEAD_CONVERTED, DEAL_WON, HANDOFF_DELIVERED, DORMANT, REACTIVATED, RENEWAL_WINDOW, RENEWAL_DONE or MANUAL.
  reason            String
  note              String?
  actorMembershipId String?  @map("actor_membership_id")
  detail            Json?
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, companyId, createdAt(sort: Desc)])
  @@map("lifecycle_events")
}

// ---------------------------------------------------------------------------
// Stage 4 (M4): admin, automation, data and mobile sync. The checks, composite
// tenant keys and RLS live in prisma/migrations/20261027090000_m4_admin_automation_data_sync.
// ---------------------------------------------------------------------------

/// An organisation's switch and settings for one rule in the code-defined catalogue (B4.02).
/// No row means the rule is at its default.
model AutomationRule {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  ruleKey               String   @map("rule_key")
  enabled               Boolean
  config                Json     @default("{}")
  updatedByMembershipId String?  @map("updated_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ruleKey], map: "automation_rules_org_key_key")
  @@map("automation_rules")
}

/// One run of one rule on one record (B4.02). A partial unique index allows one APPLIED run per trigger.
model AutomationRun {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ruleKey        String   @map("rule_key")
  triggerKey     String   @map("trigger_key")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  status         String
  result         String
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)], map: "automation_runs_org_created_idx")
  @@map("automation_runs")
}

/// A data migration in progress or finished (B4.04): seven steps, a mapping, a dry run, an import, a rollback window.
model ImportSession {
  id                       String    @id @default(uuid())
  organizationId           String    @map("organization_id")
  entity                   String
  sourceKind               String    @default("GENERIC") @map("source_kind")
  status                   String    @default("DRAFT")
  step                     String    @default("SOURCE")
  fileId                   String?   @map("file_id")
  fileName                 String?   @map("file_name")
  headers                  Json      @default("[]")
  mapping                  Json      @default("{}")
  valueMappings            Json      @default("{}") @map("value_mappings")
  duplicatePolicy          String    @default("SKIP") @map("duplicate_policy")
  presetId                 String?   @map("preset_id")
  totalRows                Int       @default(0) @map("total_rows")
  validRows                Int       @default(0) @map("valid_rows")
  warningRows              Int       @default(0) @map("warning_rows")
  errorRows                Int       @default(0) @map("error_rows")
  duplicateRows            Int       @default(0) @map("duplicate_rows")
  processedRows            Int       @default(0) @map("processed_rows")
  createdRows              Int       @default(0) @map("created_rows")
  updatedRows              Int       @default(0) @map("updated_rows")
  skippedRows              Int       @default(0) @map("skipped_rows")
  failedRows               Int       @default(0) @map("failed_rows")
  dryRun                   Json?     @map("dry_run")
  summary                  Json?
  errorFileId              String?   @map("error_file_id")
  cancelRequested          Boolean   @default(false) @map("cancel_requested")
  failureMessage           String?   @map("failure_message")
  jobId                    String?   @map("job_id")
  createdByMembershipId    String?   @map("created_by_membership_id")
  startedAt                DateTime? @map("started_at")
  finishedAt               DateTime? @map("finished_at")
  rollbackDeadline         DateTime? @map("rollback_deadline")
  rolledBackAt             DateTime? @map("rolled_back_at")
  rolledBackByMembershipId String?   @map("rolled_back_by_membership_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id], map: "import_sessions_organization_id_id_key")
  @@map("import_sessions")
}

model ImportMappingPreset {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  name                  String
  entity                String
  mapping               Json     @default("{}")
  valueMappings         Json     @default("{}") @map("value_mappings")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("import_mapping_presets")
}

model ImportSessionIssue {
