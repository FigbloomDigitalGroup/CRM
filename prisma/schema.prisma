enum ActivityType {
  CALL
  MEETING
  NOTE
  EMAIL
  WHATSAPP
  OTHER
}

/// The CRM's timeline/interaction log. Every activity must relate to at
/// least one of Company/Contact/Lead/Deal — enforced both at the
/// application layer and by a CHECK constraint in the tenant-integrity
/// migration.
model Activity {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  type               ActivityType
