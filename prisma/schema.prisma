// FigBloom CRM — core data model.
//
// Organization is the tenant boundary; User is a separate global identity
// (a user can belong to more than one organization via Membership); access
// control is server-side RBAC scoped strictly per organization.
//
// This file defines the ORM-level shape (single-column FKs, for ergonomic
// querying). Tenant safety goes further than what's expressed here — see
// migrations/*_tenant_integrity_and_rls, which adds composite
// (organization_id, parent_id) foreign keys and Postgres RLS policies so a
// child row can never reference a parent in a different organization, even
// if an application-layer filter is missed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. Identity & tenant foundation
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships             Membership[]
  settings                OrganizationSetting[]
  websiteApiKey           WebsiteApiKey?
  websiteLeadRequestLogs  WebsiteLeadRequestLog[]
  inboundEmailKey         InboundEmailKey?
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPreferences NotificationPreference[]
  companies               Company[]
  contacts                Contact[]
  leads                   Lead[]
  deals                   Deal[]
  activities              Activity[]
  tasks                   Task[]
  communications          Communication[]
  proposalReferences      ProposalReference[]
  companyServices         CompanyService[]
  auditEvents             AuditEvent[]
  leadSources             LeadSource[]
  leadStatuses            LeadStatus[]
  pipelineStages          PipelineStage[]
  customerLifecycleStates CustomerLifecycleState[]
  lostReasons             LostReason[]
  services                Service[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// The global authenticated identity — intentionally not the tenant
/// boundary (see Membership). passwordHash is nullable so a user can exist
/// (provisioned via Membership creation) before a password is ever set --
/// the same password-reset-token flow that handles "forgot password"
/// (FIG-592) also handles setting the first password.
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships         Membership[]
  auditEvents         AuditEvent[]         @relation("AuditActorUser")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// A real, revocable, server-tracked login session (FIG-592) -- the
/// production replacement for src/auth/devSession.ts's stateless signed
/// cookie. Only `tokenHash` is stored (see src/auth/session.ts, same
/// generate-random/hash-and-compare pattern as WebsiteApiKey below); the
/// plaintext token exists only in the client's cookie. Not organization-
/// scoped -- a session belongs to a User, same tier as Membership.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Single-use, short-lived token backing both "forgot password" and
/// "set your first password" (FIG-592) -- see the User model's doc comment
/// for why one flow covers both. Only `tokenHash` is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Fixed V1 role catalog (Management, Sales, Delivery, Finance, Restricted
/// Technical). RBAC is a security rule, not organization-configurable
/// business data, so this is global rather than per-organization.
model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Permission catalog backing the role/permission mapping. The final
/// matrix is still provisional — see IMPLEMENTATION_NOTES.md.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  area        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  /// Invited but not yet accepted (FIG-593) -- carries no permissions at
  /// all; `resolveActiveMembership` only ever matches ACTIVE, so a pending
  /// invite grants zero access until accepted.
  PENDING
}

/// A user's relationship to one Organization — the actual tenant boundary.
/// Kept separate from User so a user can hold memberships in more than one
/// organization without that affecting their global identity.
///
/// CRM records reference their owner via Membership, not User directly:
/// since a membership belongs to exactly one organization, any FK to a
/// membership carries an implicit, DB-checkable organization binding (see
/// the composite FK added in the tenant-integrity migration).
model Membership {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  userId               String           @map("user_id")
  roleId               String           @map("role_id")
  status               MembershipStatus @default(ACTIVE)
  invitedAt            DateTime?        @map("invited_at")
  joinedAt             DateTime?        @map("joined_at")
  /// Set only while status is PENDING (FIG-593) -- only the hash is
  /// stored, same generate-random/hash-and-compare pattern as sessions and
  /// the website API key. Cleared (both columns) the moment the invite is
  /// accepted, enforcing single use.
  inviteTokenHash      String?          @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime?        @map("invite_token_expires_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  ownedCompanies         Company[]           @relation("CompanyOwner")
  createdCompanies       Company[]           @relation("CompanyCreatedBy")
  ownedContacts          Contact[]           @relation("ContactOwner")
  createdContacts        Contact[]           @relation("ContactCreatedBy")
  ownedLeads             Lead[]              @relation("LeadOwner")
  createdLeads           Lead[]              @relation("LeadCreatedBy")
  ownedDeals             Deal[]              @relation("DealOwner")
  createdDeals           Deal[]              @relation("DealCreatedBy")
  authoredActivities     Activity[]          @relation("ActivityAuthor")
  assignedTasks          Task[]              @relation("TaskAssignee")
  createdTasks           Task[]              @relation("TaskCreatedBy")
  authoredCommunications Communication[]     @relation("CommunicationAuthor")
  ownedProposals         ProposalReference[] @relation("ProposalOwner")
  auditEvents            AuditEvent[]        @relation("AuditActorMembership")
  createdWebsiteApiKeys  WebsiteApiKey[]     @relation("WebsiteApiKeyCreatedBy")
  createdInboundEmailKeys InboundEmailKey[]  @relation("InboundEmailKeyCreatedBy")
  notifications          Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// Generic organization-scoped key/value bucket for settings that don't
/// warrant a dedicated table yet (e.g. the website lead-capture
/// round-robin cursor).
model OrganizationSetting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

/// Static per-organization credential for the public, session-less website
/// lead-capture endpoint — see IMPLEMENTATION_NOTES.md for why this was
/// chosen over a signed webhook. Only the SHA-256 hash is stored; the
/// plaintext key is shown once, at generation time. One active key per
/// organization — rotating replaces it outright, no overlap window.
///
/// The abuse-protection fields below (FIG-594) are all optional/off by
/// default, so existing integrations that predate this ticket keep working
/// unchanged: `allowedOrigins` empty means no origin restriction,
/// `honeypotFieldName`/`captchaSecret` null means neither check runs.
model WebsiteApiKey {
  id                    String    @id @default(uuid())
  organizationId        String    @unique @map("organization_id")
  keyHash               String    @map("key_hash")
  keyPrefix             String    @map("key_prefix")
  createdByMembershipId String?   @map("created_by_membership_id")
  lastUsedAt            DateTime? @map("last_used_at")
  /// Explicit revoke without rotating (FIG-594) -- disables the
  /// integration entirely; distinct from rotation, which replaces the key
  /// with a new working one instead of leaving it disabled.
  revokedAt             DateTime? @map("revoked_at")
  /// Empty = no restriction. Checked against the request's Origin header
  /// (falling back to Referer's origin) only when non-empty, since the
  /// documented integration pattern is a server-to-server call that may
  /// send neither header at all.
  allowedOrigins        String[]  @default([]) @map("allowed_origins")
  /// Name of a body field real submitters must leave empty; a bot that
  /// fills it in is silently discarded (logged, but told it "succeeded").
  honeypotFieldName     String?   @map("honeypot_field_name")
  /// Cloudflare Turnstile secret key, if this organization's website form
  /// uses Turnstile. Server-side only, never sent to any client.
  captchaSecret         String?   @map("captcha_secret")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("WebsiteApiKeyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@map("website_api_keys")
}

/// Static per-organization credential for the inbound-email webhook
/// (FIG-598) -- a separate credential from WebsiteApiKey above because it's
/// a different trust boundary (a real inbound-email provider's webhook
/// call, e.g. Postmark/Mailgun inbound parse, not the public website lead
/// form), not because the generate/hash/revoke shape differs. Same
/// generate-random/hash-and-compare pattern, only the SHA-256 hash is
/// stored, one active key per organization. No account with a real inbound-
/// email provider exists for this project -- see
/// `src/services/inboundEmailService.ts` and IMPLEMENTATION_NOTES.md for
/// what that means in practice.
model InboundEmailKey {
  id                    String    @id @default(uuid())
  organizationId        String    @unique @map("organization_id")
  keyHash               String    @map("key_hash")
  keyPrefix             String    @map("key_prefix")
  createdByMembershipId String?   @map("created_by_membership_id")
  lastUsedAt            DateTime? @map("last_used_at")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("InboundEmailKeyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@map("inbound_email_keys")
}

/// Every request to the public lead-capture endpoint, accepted or rejected
/// (FIG-594) -- this is both the audit trail for "rejected/blocked
/// submissions are logged and visible for monitoring" and the data source
/// rate limiting counts against, so there's one mechanism instead of two.
/// `organizationId` is nullable because an unresolvable org slug never
/// gets that far. `keyHash` is the full SHA-256 hash of whatever key the
/// caller submitted (valid or not) -- not the short display `keyPrefix`
/// shown in the settings UI, which only has a few characters of real
/// entropy and would let unrelated keys share a rate-limit bucket by
/// chance; it's nullable because a request with no key at all still gets
/// logged (and still counts toward per-IP rate limiting).
model WebsiteLeadRequestLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  keyHash        String?  @map("key_hash")
  ipAddress      String?  @map("ip_address")
  origin         String?
  outcome        String
  reason         String?
  leadId         String?  @map("lead_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([keyHash, createdAt])
  @@index([ipAddress, createdAt])
  @@map("website_lead_request_log")
}

/// What a Notification is "about" (FIG-597). Each type is deduplicated to
/// at most one Notification per entity (see Notification's unique index
/// below) -- a lead is only ever announced once, and a task crosses into
/// "due" or "overdue" once, even though the generator script that creates
/// these runs repeatedly.
enum NotificationType {
  LEAD_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
}

/// In-app notification feed entry for one membership (FIG-597). Always has
/// an internal recipient -- the public website-enquirer acknowledgement
/// has no membership to notify, so it only ever produces a
/// NotificationDelivery with `notificationId: null`, never a row here.
model Notification {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  membershipId   String           @map("membership_id")
  type           NotificationType
  title          String
  body           String
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  link           String?
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  // Idempotency for the due/overdue generator script lives in the
  // migration as a PARTIAL unique index (TASK_DUE/TASK_OVERDUE only) --
  // Prisma's schema DSL can't express a WHERE clause on an index, so it's
  // invisible here, same as the hand-written composite tenant-integrity
  // FKs (see tenant_integrity_and_rls's header comment). A blanket
  // (organization_id, membership_id, type, entity_type, entity_id) unique
  // index would be wrong for LEAD_ASSIGNED: reassigning a lead back to its
  // original owner is a second, real event for the *same* entity+type+
  // membership triple, and must still notify.
  @@index([organizationId, membershipId, readAt])
  @@map("notifications")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  EXHAUSTED
}

/// One retryable outbound send (FIG-597) -- either the email/SMS side of an
/// internal Notification above (`notificationId` set), or a standalone send
/// with no internal recipient at all, like the website-enquirer
/// acknowledgement (`notificationId: null`, `recipientEmail`/`recipientPhone`
/// is the enquirer's own contact info, not a membership's).
///
/// `payload` carries whatever the template function needs to re-render the
/// message on retry without re-deriving it from (possibly since-changed)
/// business records. Retried by `scripts/notifications-sweep.ts` -- see
/// that file and docs/DEPLOYMENT.md for why this project has no job queue
/// to hand retries to instead.
model NotificationDelivery {
  id              String                     @id @default(uuid())
  organizationId  String                     @map("organization_id")
  notificationId  String?                    @map("notification_id")
  channel         NotificationChannel
  recipientEmail  String?                    @map("recipient_email")
  recipientPhone  String?                    @map("recipient_phone")
  templateKey     String                     @map("template_key")
  payload         Json?
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                        @default(0)
  maxAttempts     Int                        @default(5) @map("max_attempts")
  lastError       String?                    @map("last_error")
  nextAttemptAt   DateTime                   @default(now()) @map("next_attempt_at")
  sentAt          DateTime?                  @map("sent_at")
  createdAt       DateTime                   @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_deliveries")
}

/// Per-membership override of the default notification behavior (FIG-597).
/// Absence of a row for a given (membership, type) means "both channels on"
/// -- the default -- so existing memberships need no backfill when this
/// table is introduced; a row only ever exists once someone actually changes
/// a default, the same "off unless configured" shape as WebsiteApiKey's
/// abuse-protection fields.
model NotificationPreference {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  membershipId   String           @map("membership_id")
  type           NotificationType
  emailEnabled   Boolean          @default(true) @map("email_enabled")
  inAppEnabled   Boolean          @default(true) @map("in_app_enabled")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// 2. Controlled reference data (organization-scoped)
// ---------------------------------------------------------------------------

model LeadSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lead_sources")
}

/// Kept separate from Lead Temperature (a fixed HOT/WARM/COLD enum) and
/// from Deal Pipeline Stage / Customer Lifecycle State.
model LeadStatus {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lead_statuses")
}

/// Deal pipeline stage — kept strictly separate from Lead Status and
/// Customer Lifecycle State. A Deal only exists once a Lead has qualified,
/// so this catalog covers the deal side of the funnel (Solution Presented
/// -> ... -> Closed Won/Lost). See IMPLEMENTATION_NOTES.md for where the
/// lead/deal split happens.
model PipelineStage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  probability    Int?
  isWon          Boolean  @default(false) @map("is_won")
  isLost         Boolean  @default(false) @map("is_lost")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("pipeline_stages")
}

/// Lifecycle state applies at the Company (account) level — Company is the
/// canonical account identity, not a separate `customers` table; lifecycle
/// is just one of its attributes.
model CustomerLifecycleState {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies    Company[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("customer_lifecycle_states")
}

/// Shared catalog of lost/disqualification reasons, referenced by both
/// Lead and Deal.
model LostReason {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lost_reasons")
}

/// FigBloom's own service/product catalog (Web Dev, Branding, CCTV,
/// Starlink/Internet, HR automation, etc).
model Service {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  category       String?
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads           Lead[]
  deals           Deal[]
  companyServices CompanyService[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("services")
}

// ---------------------------------------------------------------------------
// 3. Core CRM records
// ---------------------------------------------------------------------------

/// The CRM's canonical business/account entity. Duplicate company names
/// are legitimate, so no uniqueness is enforced on name — duplicate
/// detection is an application-level concern informed by the
/// name/email/phone indexes below.
model Company {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  name                  String
  industry              String?
  website               String?
  location              String?
  phone                 String?
  email                 String?
  notes                 String?
  lifecycleStateId      String?  @map("lifecycle_state_id")
  ownerMembershipId     String?  @map("owner_membership_id")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lifecycleState CustomerLifecycleState? @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
  owner          Membership?             @relation("CompanyOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy      Membership?             @relation("CompanyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  contacts        Contact[]
  leads           Lead[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  communications  Communication[]
  companyServices CompanyService[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, lifecycleStateId])
  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("companies")
}

/// A person, distinct from Company. A contact with no company is
/// supported (e.g. an individual lead with no business behind them yet).
model Contact {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  companyId             String?  @map("company_id")
  firstName             String   @map("first_name")
  lastName              String?  @map("last_name")
  phone                 String?
  email                 String?
  jobTitle              String?  @map("job_title")
  department            String?
  socialProfiles        Json?    @map("social_profiles")
  notes                 String?
  ownerMembershipId     String?  @map("owner_membership_id")
  createdByMembershipId String?  @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        Membership?  @relation("ContactOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy    Membership?  @relation("ContactCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  leads          Lead[]
  dealsAsPrimary Deal[]          @relation("DealPrimaryContact")
  activities     Activity[]
  tasks          Task[]
  communications Communication[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("contacts")
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

/// A prospect before/during qualification. Lead Status, Temperature, and
/// Source are independent classifications. `qualificationData` holds
/// service-specific qualification questions (e.g. property/internet
/// details) without needing a full custom-fields subsystem.
model Lead {
  id                    String          @id @default(uuid())
  organizationId        String          @map("organization_id")
  companyId             String?         @map("company_id")
  contactId             String?         @map("contact_id")
  leadSourceId          String?         @map("lead_source_id")
  leadStatusId          String          @map("lead_status_id")
  temperature           LeadTemperature @default(WARM)
  serviceInterestId     String?         @map("service_interest_id")
  ownerMembershipId     String?         @map("owner_membership_id")
  qualificationData     Json?           @map("qualification_data")
  lostReasonId          String?         @map("lost_reason_id")
  nextFollowUpAt        DateTime?       @map("next_follow_up_at")
  convertedAt           DateTime?       @map("converted_at")
  notes                 String?
  createdByMembershipId String?         @map("created_by_membership_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadSource      LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  leadStatus      LeadStatus   @relation(fields: [leadStatusId], references: [id], onDelete: Restrict)
  serviceInterest Service?     @relation(fields: [serviceInterestId], references: [id], onDelete: SetNull)
  owner           Membership?  @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy       Membership?  @relation("LeadCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  lostReason      LostReason?  @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  communications Communication[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, leadStatusId])
  @@index([organizationId, leadSourceId])
  @@index([organizationId, temperature])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, companyId])
  @@index([organizationId, nextFollowUpAt])
  @@map("leads")
}

enum DealOutcome {
  OPEN
  WON
  LOST
}

/// A sales opportunity with its own Pipeline Stage, kept strictly separate
/// from Lead Status and Customer Lifecycle State. The unique
/// (organizationId, leadId) constraint stops a single Lead from being
/// converted into more than one Deal, while still allowing many Deals with
/// no originating Lead (leadId null — e.g. an existing-customer upsell).
model Deal {
  id                    String      @id @default(uuid())
  organizationId        String      @map("organization_id")
  companyId             String      @map("company_id")
  primaryContactId      String?     @map("primary_contact_id")
  leadId                String?     @map("lead_id")
  serviceId             String?     @map("service_id")
  ownerMembershipId     String      @map("owner_membership_id")
  pipelineStageId       String      @map("pipeline_stage_id")
  value                 Decimal?    @db.Decimal(14, 2)
  currency              String      @default("KES")
  expectedCloseDate     DateTime?   @map("expected_close_date") @db.Date
  outcome               DealOutcome @default(OPEN)
  lostReasonId          String?     @map("lost_reason_id")
  wonAt                 DateTime?   @map("won_at")
  lostAt                DateTime?   @map("lost_at")
  notes                 String?
  createdByMembershipId String?     @map("created_by_membership_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact Contact?      @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  owner          Membership    @relation("DealOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  createdBy      Membership?   @relation("DealCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  pipelineStage  PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  lostReason     LostReason?   @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  activities         Activity[]
  tasks              Task[]
  communications     Communication[]
  proposalReferences ProposalReference[]

  @@unique([organizationId, id])
  @@unique([organizationId, leadId])
  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, companyId])
  @@index([organizationId, outcome])
  @@index([organizationId, expectedCloseDate])
  @@map("deals")
}

// ---------------------------------------------------------------------------
// 4. Operational records
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  NOTE
  EMAIL
  WHATSAPP
  OTHER
}

/// The CRM's timeline/interaction log. Every activity must relate to at
/// least one of Company/Contact/Lead/Deal — enforced both at the
/// application layer and by a CHECK constraint in the tenant-integrity
/// migration.
model Activity {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  type               ActivityType
  subject            String?
  description        String?
  occurredAt         DateTime     @default(now()) @map("occurred_at")
  outcome            String?
  authorMembershipId String       @map("author_membership_id")
  companyId          String?      @map("company_id")
  contactId          String?      @map("contact_id")
  leadId             String?      @map("lead_id")
  dealId             String?      @map("deal_id")
  createdAt          DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Membership   @relation("ActivityAuthor", fields: [authorMembershipId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  communications Communication[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, companyId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@index([organizationId, contactId, occurredAt])
  @@index([organizationId, authorMembershipId])
  @@map("activities")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Actionable follow-up work. "Overdue" is a derived state (dueAt in the
/// past AND status not COMPLETED/CANCELLED), not a stored column — the
/// (organizationId, status, dueAt) index exists to make that derivation
/// cheap at query time.
model Task {
  id                    String       @id @default(uuid())
  organizationId        String       @map("organization_id")
  title                 String
  description           String?
  assigneeMembershipId  String       @map("assignee_membership_id")
  createdByMembershipId String       @map("created_by_membership_id")
  dueAt                 DateTime?    @map("due_at")
  priority              TaskPriority @default(MEDIUM)
  status                TaskStatus   @default(PENDING)
  completedAt           DateTime?    @map("completed_at")
  companyId             String?      @map("company_id")
  contactId             String?      @map("contact_id")
  leadId                String?      @map("lead_id")
  dealId                String?      @map("deal_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     Membership   @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Restrict)
  createdBy    Membership   @relation("TaskCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, assigneeMembershipId, status])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
  @@map("tasks")
}

enum CommunicationChannel {
  EMAIL
  PHONE
  WHATSAPP
  SMS
  MEETING
  SOCIAL
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

/// Channel-specific interaction detail. May optionally point at the
/// Activity timeline entry it corresponds to, avoiding duplicate parallel
/// histories.
model Communication {
  id                 String                 @id @default(uuid())
  organizationId     String                 @map("organization_id")
  channel            CommunicationChannel
  direction          CommunicationDirection
  occurredAt         DateTime               @default(now()) @map("occurred_at")
  subject            String?
  summary            String
  externalReference  String?                @map("external_reference")
  /// Null for an inbound communication logged by the webhook in
  /// `src/services/inboundEmailService.ts` (FIG-598) -- there is no CRM
  /// user to attribute it to. Every other create path (manual log, "send
  /// and log email") always stamps the caller's own membership.
  authorMembershipId String?                @map("author_membership_id")
  activityId         String?                @map("activity_id")
  companyId          String?                @map("company_id")
  contactId          String?                @map("contact_id")
  leadId             String?                @map("lead_id")
  dealId             String?                @map("deal_id")
  createdAt          DateTime               @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Membership?  @relation("CommunicationAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  activity     Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, companyId, occurredAt])
  @@index([organizationId, contactId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, dealId, occurredAt])
  @@index([organizationId, channel])
  @@map("communications")
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Proposal/quotation *reference* only — no document generation or
/// e-signature flow.
model ProposalReference {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  dealId            String         @map("deal_id")
  proposalNumber    String         @map("proposal_number")
  status            ProposalStatus @default(DRAFT)
  amount            Decimal?       @db.Decimal(14, 2)
  currency          String         @default("KES")
  ownerMembershipId String?        @map("owner_membership_id")
  sentAt            DateTime?      @map("sent_at")
  respondedAt       DateTime?      @map("responded_at")
  documentReference String?        @map("document_reference")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("ProposalOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dealId, proposalNumber])
  @@index([organizationId])
  @@index([organizationId, dealId])
  @@index([organizationId, status])
  @@map("proposal_references")
}

enum CompanyServiceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Tracks which services a Company has/had, independent of any single
/// Deal — supports a customer holding multiple services at once, and
/// future renewal/retainer reporting.
model CompanyService {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  companyId      String               @map("company_id")
  serviceId      String               @map("service_id")
  status         CompanyServiceStatus @default(ACTIVE)
  startDate      DateTime?            @map("start_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, serviceId, status])
  @@map("company_services")
}

// ---------------------------------------------------------------------------
// 5. Governance
// ---------------------------------------------------------------------------

/// Append-only. organizationId is nullable to allow platform-level events
/// (e.g. organization provisioning) that precede any organization-scoped
/// action; ordinary business-record events always carry it. Immutability
/// (no UPDATE/DELETE for the application role) is enforced via a REVOKE in
/// the tenant-integrity migration, not just by omitting an updatedAt
/// column here.
model AuditEvent {
  id                String   @id @default(uuid())
  organizationId    String?  @map("organization_id")
  actorUserId       String?  @map("actor_user_id")
  actorMembershipId String?  @map("actor_membership_id")
  action            String
  entityType        String   @map("entity_type")
  entityId          String?  @map("entity_id")
  previousValue     Json?    @map("previous_value")
  newValue          Json?    @map("new_value")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser       User?         @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership Membership?   @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorMembershipId])
  @@map("audit_events")
}
