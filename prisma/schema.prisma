// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  NOTE
  EMAIL
  WHATSAPP
  OTHER
}

/// The CRM's timeline/interaction log. Every activity must relate to at
/// least one of Company/Contact/Lead/Deal — enforced both at the
/// application layer and by a CHECK constraint in the tenant-integrity
/// migration.
model Activity {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  type               ActivityType
  subject            String?
  description        String?
  occurredAt         DateTime     @default(now()) @map("occurred_at")
  outcome            String?
  authorMembershipId String       @map("author_membership_id")
  companyId          String?      @map("company_id")
  contactId          String?      @map("contact_id")
  leadId             String?      @map("lead_id")
  dealId             String?      @map("deal_id")
  createdAt          DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Membership   @relation("ActivityAuthor", fields: [authorMembershipId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

