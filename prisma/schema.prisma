// FigBloom CRM — core data model.
//
// Organization is the tenant boundary; User is a separate global identity
// (a user can belong to more than one organization via Membership); access
// control is server-side RBAC scoped strictly per organization.
//
// This file defines the ORM-level shape (single-column FKs, for ergonomic
// querying). Tenant safety goes further than what's expressed here — see
// migrations/*_tenant_integrity_and_rls, which adds composite
// (organization_id, parent_id) foreign keys and Postgres RLS policies so a
// child row can never reference a parent in a different organization, even
// if an application-layer filter is missed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. Identity & tenant foundation
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  /// Profile/defaults/working-hours (FIG-604). Deliberately plain typed
  /// columns, not more `OrganizationSetting` rows -- this is a small, fixed,
  /// validated shape (unlike `OrganizationSetting`'s open-ended JSON bag,
  /// used for internal runtime state like the lead-assignment cursor), so a
  /// real column per field is simpler and keeps the DB schema self-
  /// documenting about what tenant profile data actually exists.
  timezone              String   @default("Africa/Nairobi")
  defaultCurrency       String   @default("KES") @map("default_currency")
  phone                 String?
  website               String?
  address               String?
  /// Day keys, e.g. ["MON","TUE","WED","THU","FRI"] -- see
  /// `src/services/organizationProfileService.ts`'s `WORKING_DAY_KEYS` for
  /// the closed set of valid values.
  workingDays           String[] @default(["MON", "TUE", "WED", "THU", "FRI"]) @map("working_days")
  /// 24-hour "HH:MM" strings (e.g. "08:00"), or both null if not set.
  workingHoursStart     String?  @map("working_hours_start")
  workingHoursEnd       String?  @map("working_hours_end")
  /// B1.09: how the organisation looks. `allowPersonalisation` is the
  /// `personalisation.allowed` toggle, not a column.
  displayName           String?  @map("display_name")
  logoFileId            String?  @map("logo_file_id")
  defaultTheme          String   @default("FOREST") @map("default_theme")
  defaultPageColour     String   @default("WHITE") @map("default_page_colour")
  showLogoOnClientPages Boolean  @default(false) @map("show_logo_on_client_pages")

  memberships                Membership[]
  settings                   OrganizationSetting[]
  websiteApiKey              WebsiteApiKey?
  websiteLeadRequestLogs     WebsiteLeadRequestLog[]
  inboundEmailKey            InboundEmailKey?
  notifications              Notification[]
  notificationDeliveries     NotificationDelivery[]
  notificationPreferences    NotificationPreference[]
  companies                  Company[]
  contacts                   Contact[]
  leads                      Lead[]
  deals                      Deal[]
  activities                 Activity[]
  tasks                      Task[]
  communications             Communication[]
  proposalReferences         ProposalReference[]
  companyServices            CompanyService[]
  auditEvents                AuditEvent[]
  leadSources                LeadSource[]
  leadStatuses               LeadStatus[]
  pipelineStages             PipelineStage[]
  customerLifecycleStates    CustomerLifecycleState[]
  lostReasons                LostReason[]
  services                   Service[]
  websiteLeadAssignmentRules WebsiteLeadAssignmentRule[]
  pageViews                  PageView[]
  dealHandoffs               DealHandoff[]
  idempotencyKeys            IdempotencyKey[]
  backgroundJobs             BackgroundJob[]
  mergeRecords               MergeRecord[]
  customFieldDefinitions     CustomFieldDefinition[]
  tags                       Tag[]
  tagLinks                   TagLink[]
  searchRecents              SearchRecent[]
  comments                   Comment[]
  commentMentions            CommentMention[]
  recordFollows              RecordFollow[]
  dataRuns                   DataRun[]
  signalSnapshots            SignalSnapshot[]
  attachments                Attachment[]
  emailTemplates             EmailTemplate[]
  leadPoolRequests           LeadPoolRequest[]
  dealMoves                  DealMove[]
  files                      File[]
  sessions                   Session[]
  signInEvents               SignInEvent[]
  userPreferences            UserPreference[]
  notificationSettings       NotificationSetting[]
  invoices                   Invoice[]
  paymentRecords             PaymentRecord[]
  dealPaymentNotes           DealPaymentNote[]
  recurringServices          RecurringService[]
  lifecycleEvents            LifecycleEvent[]
  automationRules            AutomationRule[]
  automationRuns             AutomationRun[]
  importSessions             ImportSession[]
  importMappingPresets       ImportMappingPreset[]
  importSessionIssues        ImportSessionIssue[]
  importSessionChanges       ImportSessionChange[]
  dataSubjectRequests        DataSubjectRequest[]
  exportApprovals            ExportApproval[]
  syncMutations              SyncMutation[]
  pushSubscriptions          PushSubscription[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// The global authenticated identity — intentionally not the tenant
/// boundary (see Membership). passwordHash is nullable so a user can exist
/// (provisioned via Membership creation) before a password is ever set --
/// the same password-reset-token flow that handles "forgot password"
/// (FIG-592) also handles setting the first password.
model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  phone              String?
  passwordHash       String?    @map("password_hash")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  /// B1.05 lockout: consecutive wrong passwords, reset by a good sign-in or
  /// an unlock; `lockedUntil` in the future means sign-in is refused.
  failedSignInCount  Int        @default(0) @map("failed_sign_in_count")
  lastFailedSignInAt DateTime?  @map("last_failed_sign_in_at")
  lockedUntil        DateTime?  @map("locked_until")
  /// B1.06: the person's own time zone (IANA name); null = use the organisation's.
  timeZone           String?    @map("time_zone")

  memberships         Membership[]
  auditEvents         AuditEvent[]         @relation("AuditActorUser")
  sessions            Session[]
  signInEvents        SignInEvent[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// A real, revocable, server-tracked login session (FIG-592) -- the
/// production replacement for src/auth/devSession.ts's stateless signed
/// cookie. Only `tokenHash` is stored (see src/auth/session.ts, same
/// generate-random/hash-and-compare pattern as WebsiteApiKey below); the
/// plaintext token exists only in the client's cookie. Not organization-
/// scoped -- a session belongs to a User, same tier as Membership.
model Session {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  revokedAt         DateTime? @map("revoked_at")
  userAgent         String?   @map("user_agent")
  /// B1.04: the organisation the session was signed in under (the user's
  /// oldest active membership); null for a user with no organisation yet.
  organizationId    String?   @map("organization_id")
  deviceLabel       String?   @map("device_label")
  ipAddress         String?   @map("ip_address")
  place             String?
  /// The ceiling `extend` can never push `expiresAt` past.
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  /// Why it ended: SIGNED_OUT, REVOKED, SIGNED_OUT_OTHERS, DEACTIVATED,
  /// REMOVED, PASSWORD_RESET, LOCKED.
  revokedReason     String?   @map("revoked_reason")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Single-use, short-lived token backing both "forgot password" and
/// "set your first password" (FIG-592) -- see the User model's doc comment
/// for why one flow covers both. Only `tokenHash` is stored.
/// B1.04: one row per sign-in attempt worth showing -- success, failure,
/// lockout, new device. Written once per organisation the user belongs to (so
/// each tenant sees only its own people); an attempt that belongs to no
/// organisation has a null `organizationId` and is invisible to every tenant.
model SignInEvent {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  userId         String?       @map("user_id")
  email          String
  outcome        SignInOutcome
  reason         String?
  sessionId      String?       @map("session_id")
  deviceLabel    String?       @map("device_label")
  userAgent      String?       @map("user_agent")
  ipAddress      String?       @map("ip_address")
  place          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId])
  @@index([organizationId, outcome])
  @@index([userId, deviceLabel])
  @@map("sign_in_events")
}

enum SignInOutcome {
  SUCCESS
  FAILURE
  LOCKOUT
  NEW_DEVICE
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Fixed V1 role catalog (Management, Sales, Delivery, Finance, Restricted
/// Technical). RBAC is a security rule, not organization-configurable
/// business data, so this is global rather than per-organization.
model Role {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String?
  isSystem        Boolean  @default(true) @map("is_system")
  /// Feature toggle that must be on for the role to be assignable (B1.01).
  requiredFeature String?  @map("required_feature")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Permission catalog backing the role/permission mapping. The final
/// matrix is still provisional — see IMPLEMENTATION_NOTES.md.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  area        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  /// Invited but not yet accepted (FIG-593) -- carries no permissions at
  /// all; `resolveActiveMembership` only ever matches ACTIVE, so a pending
  /// invite grants zero access until accepted.
  PENDING
  /// Membership ended (B1.05/B1.12). The row stays for history; every record
  /// the member owned had to be reassigned first.
  REMOVED
}

/// A user's relationship to one Organization — the actual tenant boundary.
/// Kept separate from User so a user can hold memberships in more than one
/// organization without that affecting their global identity.
///
/// CRM records reference their owner via Membership, not User directly:
/// since a membership belongs to exactly one organization, any FK to a
/// membership carries an implicit, DB-checkable organization binding (see
/// the composite FK added in the tenant-integrity migration).
model Membership {
  id                        String           @id @default(uuid())
  organizationId            String           @map("organization_id")
  userId                    String           @map("user_id")
  roleId                    String           @map("role_id")
  status                    MembershipStatus @default(ACTIVE)
  invitedAt                 DateTime?        @map("invited_at")
  joinedAt                  DateTime?        @map("joined_at")
  /// Set only while status is PENDING (FIG-593) -- only the hash is
  /// stored, same generate-random/hash-and-compare pattern as sessions and
  /// the website API key. Cleared (both columns) the moment the invite is
  /// accepted, enforcing single use.
  inviteTokenHash           String?          @unique @map("invite_token_hash")
  inviteTokenExpiresAt      DateTime?        @map("invite_token_expires_at")
  /// B1.12: who acted and when, per state. Actors are memberships of the same
  /// organisation (composite foreign keys in the migration).
  invitedByMembershipId     String?          @map("invited_by_membership_id")
  inviteLastSentAt          DateTime?        @map("invite_last_sent_at")
  deactivatedAt             DateTime?        @map("deactivated_at")
  deactivatedByMembershipId String?          @map("deactivated_by_membership_id")
  removedAt                 DateTime?        @map("removed_at")
  removedByMembershipId     String?          @map("removed_by_membership_id")
  /// B1.06: the picture (a READY AVATAR file in the same organisation; composite
  /// foreign key in the migration) and where it was cropped from.
  avatarFileId              String?          @map("avatar_file_id")
  avatarCrop                Json?            @map("avatar_crop")
  avatarUpdatedAt           DateTime?        @map("avatar_updated_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  ownedCompanies           Company[]                   @relation("CompanyOwner")
  createdCompanies         Company[]                   @relation("CompanyCreatedBy")
  ownedContacts            Contact[]                   @relation("ContactOwner")
  createdContacts          Contact[]                   @relation("ContactCreatedBy")
  ownedLeads               Lead[]                      @relation("LeadOwner")
  createdLeads             Lead[]                      @relation("LeadCreatedBy")
  ownedDeals               Deal[]                      @relation("DealOwner")
  createdDeals             Deal[]                      @relation("DealCreatedBy")
  authoredActivities       Activity[]                  @relation("ActivityAuthor")
  assignedTasks            Task[]                      @relation("TaskAssignee")
  createdTasks             Task[]                      @relation("TaskCreatedBy")
  authoredCommunications   Communication[]             @relation("CommunicationAuthor")
  ownedProposals           ProposalReference[]         @relation("ProposalOwner")
  auditEvents              AuditEvent[]                @relation("AuditActorMembership")
  createdWebsiteApiKeys    WebsiteApiKey[]             @relation("WebsiteApiKeyCreatedBy")
  createdInboundEmailKeys  InboundEmailKey[]           @relation("InboundEmailKeyCreatedBy")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  userPreferences          UserPreference[]
  notificationSettings     NotificationSetting[]
  assignedWebsiteLeadRules WebsiteLeadAssignmentRule[] @relation("WebsiteLeadAssignmentRuleAssignee")
  pageViews                PageView[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// Generic organization-scoped key/value bucket for settings that don't
/// warrant a dedicated table yet (e.g. the website lead-capture
/// round-robin cursor).
model OrganizationSetting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

/// Static per-organization credential for the public, session-less website
/// lead-capture endpoint — see IMPLEMENTATION_NOTES.md for why this was
/// chosen over a signed webhook. Only the SHA-256 hash is stored; the
/// plaintext key is shown once, at generation time. One active key per
/// organization — rotating replaces it outright, no overlap window.
///
/// The abuse-protection fields below (FIG-594) are all optional/off by
/// default, so existing integrations that predate this ticket keep working
/// unchanged: `allowedOrigins` empty means no origin restriction,
/// `honeypotFieldName`/`captchaSecret` null means neither check runs.
model WebsiteApiKey {
  id                    String    @id @default(uuid())
  organizationId        String    @unique @map("organization_id")
  keyHash               String    @map("key_hash")
  keyPrefix             String    @map("key_prefix")
  createdByMembershipId String?   @map("created_by_membership_id")
  lastUsedAt            DateTime? @map("last_used_at")
  /// Explicit revoke without rotating (FIG-594) -- disables the
  /// integration entirely; distinct from rotation, which replaces the key
  /// with a new working one instead of leaving it disabled.
  revokedAt             DateTime? @map("revoked_at")
  /// Empty = no restriction. Checked against the request's Origin header
  /// (falling back to Referer's origin) only when non-empty, since the
  /// documented integration pattern is a server-to-server call that may
  /// send neither header at all.
  allowedOrigins        String[]  @default([]) @map("allowed_origins")
  /// Name of a body field real submitters must leave empty; a bot that
  /// fills it in is silently discarded (logged, but told it "succeeded").
  honeypotFieldName     String?   @map("honeypot_field_name")
  /// Cloudflare Turnstile secret key, if this organization's website form
  /// uses Turnstile. Server-side only, never sent to any client.
  captchaSecret         String?   @map("captcha_secret")
  /// B4.01: after a rotation the previous key keeps working until this time, so a live website form never breaks mid-change.
  previousKeyHash       String?   @map("previous_key_hash")
  previousKeyPrefix     String?   @map("previous_key_prefix")
  previousKeyExpiresAt  DateTime? @map("previous_key_expires_at")
  rotatedAt             DateTime? @map("rotated_at")
  lastAcceptedAt        DateTime? @map("last_accepted_at")
  lastRejectedAt        DateTime? @map("last_rejected_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("WebsiteApiKeyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@map("website_api_keys")
}

/// Static per-organization credential for the inbound-email webhook
/// (FIG-598) -- a separate credential from WebsiteApiKey above because it's
/// a different trust boundary (a real inbound-email provider's webhook
/// call, e.g. Postmark/Mailgun inbound parse, not the public website lead
/// form), not because the generate/hash/revoke shape differs. Same
/// generate-random/hash-and-compare pattern, only the SHA-256 hash is
/// stored, one active key per organization. No account with a real inbound-
/// email provider exists for this project -- see
/// `src/services/inboundEmailService.ts` and IMPLEMENTATION_NOTES.md for
/// what that means in practice.
model InboundEmailKey {
  id                    String    @id @default(uuid())
  organizationId        String    @unique @map("organization_id")
  keyHash               String    @map("key_hash")
  keyPrefix             String    @map("key_prefix")
  createdByMembershipId String?   @map("created_by_membership_id")
  lastUsedAt            DateTime? @map("last_used_at")
  /// B4.01: the last message that could not be processed, for the Settings status line.
  lastErrorAt           DateTime? @map("last_error_at")
  lastError             String?   @map("last_error")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("InboundEmailKeyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@map("inbound_email_keys")
}

/// Every request to the public lead-capture endpoint, accepted or rejected
/// (FIG-594) -- this is both the audit trail for "rejected/blocked
/// submissions are logged and visible for monitoring" and the data source
/// rate limiting counts against, so there's one mechanism instead of two.
/// `organizationId` is nullable because an unresolvable org slug never
/// gets that far. `keyHash` is the full SHA-256 hash of whatever key the
/// caller submitted (valid or not) -- not the short display `keyPrefix`
/// shown in the settings UI, which only has a few characters of real
/// entropy and would let unrelated keys share a rate-limit bucket by
/// chance; it's nullable because a request with no key at all still gets
/// logged (and still counts toward per-IP rate limiting).
model WebsiteLeadRequestLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  keyHash        String?  @map("key_hash")
  ipAddress      String?  @map("ip_address")
  origin         String?
  outcome        String
  reason         String?
  leadId         String?  @map("lead_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([keyHash, createdAt])
  @@index([ipAddress, createdAt])
  @@map("website_lead_request_log")
}

/// Website lead assignment rules (FIG-751) -- evaluated in `sequence` order
/// ahead of the single round-robin/unassigned switch
/// (`WEBSITE_LEAD_ASSIGNMENT_MODE_SETTING_KEY` in `leadIngestion.ts`, FIG-599);
/// the first active rule whose non-null `leadSourceId`/`serviceId` both match
/// the incoming lead wins, and a rule with neither set is rejected at the
/// service layer as meaningless. No matching rule (or a matching rule with
/// no currently-eligible assignee) falls back to that existing switch
/// unchanged -- see `leadIngestion.ts`'s `pickOwnerForRule`.
///
/// Exactly one of `assigneeMembershipId` (a specific rep) or
/// `assigneeMembershipIds` (a round-robin group) is set -- validated in
/// `websiteLeadAssignmentRuleService.ts`, not at the DB level, since Postgres
/// can't express an FK into individual array elements (the same tradeoff
/// `WebsiteApiKey.allowedOrigins` already makes).
model WebsiteLeadAssignmentRule {
  id                       String   @id @default(uuid())
  organizationId           String   @map("organization_id")
  name                     String
  leadSourceId             String?  @map("lead_source_id")
  serviceId                String?  @map("service_id")
  assigneeMembershipId     String?  @map("assignee_membership_id")
  assigneeMembershipIds    String[] @default([]) @map("assignee_membership_ids")
  /// This rule's own round-robin cursor when `assigneeMembershipIds` is set --
  /// row-locked the same way the global cursor is (`SELECT ... FOR UPDATE` on
  /// this row), so two concurrent submissions matching this rule can't land
  /// on the same group member. Deliberately not an FK (just like the global
  /// cursor's `lastMembershipId` inside `OrganizationSetting.value` JSON) --
  /// it's an internal bookkeeping value, never traversed as a relation.
  lastAssignedMembershipId String?  @map("last_assigned_membership_id")
  sequence                 Int      @default(0)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadSource   LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignee     Membership?  @relation("WebsiteLeadAssignmentRuleAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, isActive, sequence])
  @@map("website_lead_assignment_rules")
}

/// Page-view instrumentation (FIG-752, FIG-444 metric A6) -- deliberately
/// minimal: which page, which membership, when. Nothing about what the
/// caller was looking at (no query params, no record id, no referrer) --
/// enough to answer "is this page used weekly," not enough to reconstruct
/// what anyone actually viewed. `page` is a small fixed set of labels
/// chosen by each top-level page itself (e.g. "leads", "leads_detail"),
/// never a raw URL -- see `recordPageView` call sites.
model PageView {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  membershipId   String   @map("membership_id")
  page           String
  viewedAt       DateTime @default(now()) @map("viewed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, page, viewedAt])
  @@index([organizationId, membershipId, viewedAt])
  @@map("page_views")
}

/// One row per deal that has been handed off to Delivery (FIG-792). It is the
/// idempotency marker for the won-deal handoff: the unique `dealId` means a
/// deal that is re-opened and won again does not get a second set of
/// onboarding tasks or a second notification. Later states (awaiting owner,
/// onboarding, delivered) extend this table in B2.08. The membership columns
/// are plain ids here; their tenant-integrity foreign keys are hand-written in
/// the migration like every other composite FK (see
/// `tenant_integrity_and_rls`).
model DealHandoff {
  id                        String        @id @default(uuid())
  organizationId            String        @map("organization_id")
  dealId                    String        @map("deal_id")
  deliveryOwnerMembershipId String?       @map("delivery_owner_membership_id")
  createdByMembershipId     String        @map("created_by_membership_id")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @default(now()) @updatedAt @map("updated_at")
  /// Awaiting owner until someone in Delivery takes it, then Onboarding, then Delivered (FIG-1037).
  status                    HandoffStatus @default(ONBOARDING)
  startDate                 DateTime?     @map("start_date") @db.Date
  scope                     String?
  requirements              String?
  /// [{ "title": "...", "done": false }]
  deliverables              Json          @default("[]")
  /// Membership ids working on it besides the owner.
  teamMembershipIds         Json          @default("[]") @map("team_membership_ids")
  tasksCreatedAt            DateTime?     @map("tasks_created_at")
  ownerTakenAt              DateTime?     @map("owner_taken_at")
  deliveredAt               DateTime?     @map("delivered_at")
  deliveredByMembershipId   String?       @map("delivered_by_membership_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId])
  @@index([organizationId])
  @@index([organizationId, deliveryOwnerMembershipId])
  @@map("deal_handoffs")
}

/// The identity a Platform Super Admin signs in with (FIG-1196). Separate from
/// `User`: no memberships, no organization, no tenant permissions, and no
/// access for the tenant-facing database role (RLS on with no policy, and its
/// privileges revoked). Today it only holds the dev-only Super Admin fixture
/// (`isDev`), created by `npm run seed:dev`; B6.03 adopts it for real platform
/// admins.
model PlatformIdentity {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  isDev        Boolean  @default(false) @map("is_dev")
  /// B1.08: the only look setting a platform admin has (LIGHT or DARK).
  uiMode       String   @default("LIGHT") @map("ui_mode")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_identities")
}

/// A create request already seen, keyed by the client's Idempotency-Key header
/// (FIG-1014). Replaying the same key with the same body returns the stored
/// response instead of creating the record again.
model IdempotencyKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  membershipId   String    @map("membership_id")
  key            String
  method         String
  path           String
  requestHash    String    @map("request_hash")
  /// IN_PROGRESS until the create finishes, then COMPLETED.
  status         String    @default("IN_PROGRESS")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, key], map: "idempotency_keys_org_member_key_key")
  @@index([organizationId, createdAt])
  @@map("idempotency_keys")
}

enum FilePurpose {
  AVATAR
  LOGO
  ATTACHMENT
  IMPORT
  EXPORT
}

enum FileStatus {
  UPLOADING
  READY
  QUARANTINED
  DELETED
}

/// One stored file (FIG-1023, B1.07). The bytes live in the storage driver
/// under `storageKey`, always inside `orgs/<organizationId>/`; this row is the
/// authority on owner, purpose, status and whether it may be served. Only a
/// READY file can be downloaded: QUARANTINED (malware scan) and DELETED never.
model File {
  id                String      @id @default(uuid())
  organizationId    String      @map("organization_id")
  ownerMembershipId String?     @map("owner_membership_id")
  purpose           FilePurpose
  name              String
  sizeBytes         Int         @map("size_bytes")
  mimeType          String      @map("mime_type")
  checksumSha256    String?     @map("checksum_sha256")
  storageKey        String      @unique @map("storage_key")
  status            FileStatus  @default(UPLOADING)
  scanResult        String?     @map("scan_result")
  quarantineReason  String?     @map("quarantine_reason")
  uploadExpiresAt   DateTime?   @map("upload_expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  readyAt           DateTime?   @map("ready_at")
  deletedAt         DateTime?   @map("deleted_at")
  purgedAt          DateTime?   @map("purged_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  attachment Attachment?

  @@unique([organizationId, id], map: "files_organization_id_id_key")
  @@index([organizationId, purpose, status])
  @@index([organizationId, ownerMembershipId])
  @@index([status, deletedAt])
  @@map("files")
}

/// What a Notification is "about" (FIG-597). Each type is deduplicated to
/// at most one Notification per entity (see Notification's unique index
/// below) -- a lead is only ever announced once, and a task crosses into
/// "due" or "overdue" once, even though the generator script that creates
/// these runs repeatedly.
enum NotificationType {
  LEAD_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  DEAL_WON_HANDOFF
  /// B1.11: the event types below can be preferred and delivered; the
  /// features that raise them arrive in later milestones.
  MENTION
  RENEWAL_DUE
  PROPOSAL_UNANSWERED
  STALLED_DEAL
  SUPPORT_ACCESS_REQUEST
  /// B2.02: a salesperson asks to take an unassigned lead, and the answer.
  LEAD_POOL
  /// B3.04: an invoice passed its due date, for Finance and the deal owner.
  PAYMENT_OVERDUE
  /// FIG-795: a customer went dormant, for the account owner.
  DORMANT_CUSTOMER
}

/// In-app notification feed entry for one membership (FIG-597). Always has
/// an internal recipient -- the public website-enquirer acknowledgement
/// has no membership to notify, so it only ever produces a
/// NotificationDelivery with `notificationId: null`, never a row here.
model Notification {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  membershipId   String           @map("membership_id")
  type           NotificationType
  title          String
  body           String
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  link           String?
  readAt         DateTime?        @map("read_at")
  archivedAt     DateTime?        @map("archived_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership             @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  // Idempotency for the due/overdue generator script lives in the
  // migration as a PARTIAL unique index (TASK_DUE/TASK_OVERDUE only) --
  // Prisma's schema DSL can't express a WHERE clause on an index, so it's
  // invisible here, same as the hand-written composite tenant-integrity
  // FKs (see tenant_integrity_and_rls's header comment). A blanket
  // (organization_id, membership_id, type, entity_type, entity_id) unique
  // index would be wrong for LEAD_ASSIGNED: reassigning a lead back to its
  // original owner is a second, real event for the *same* entity+type+
  // membership triple, and must still notify.
  @@index([organizationId, membershipId, readAt])
  @@index([organizationId, membershipId, archivedAt, createdAt(sort: Desc)], map: "notifications_feed_idx")
  @@map("notifications")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  EXHAUSTED
}

/// One retryable outbound send (FIG-597) -- either the email/SMS side of an
/// internal Notification above (`notificationId` set), or a standalone send
/// with no internal recipient at all, like the website-enquirer
/// acknowledgement (`notificationId: null`, `recipientEmail`/`recipientPhone`
/// is the enquirer's own contact info, not a membership's).
///
/// `payload` carries whatever the template function needs to re-render the
/// message on retry without re-deriving it from (possibly since-changed)
/// business records. Retried by `scripts/notifications-sweep.ts` -- see
/// that file and docs/DEPLOYMENT.md for why this project has no job queue
/// to hand retries to instead.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  organizationId String                     @map("organization_id")
  notificationId String?                    @map("notification_id")
  channel        NotificationChannel
  recipientEmail String?                    @map("recipient_email")
  recipientPhone String?                    @map("recipient_phone")
  templateKey    String                     @map("template_key")
  payload        Json?
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(5) @map("max_attempts")
  lastError      String?                    @map("last_error")
  nextAttemptAt  DateTime                   @default(now()) @map("next_attempt_at")
  /// B1.11: held back by the daily email cap; goes out in the next digest.
  digestPending  Boolean                    @default(false) @map("digest_pending")
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([digestPending, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Per-membership override of the default notification behavior (FIG-597).
/// Absence of a row for a given (membership, type) means "both channels on"
/// -- the default -- so existing memberships need no backfill when this
/// table is introduced; a row only ever exists once someone actually changes
/// a default, the same "off unless configured" shape as WebsiteApiKey's
/// abuse-protection fields.
model NotificationPreference {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  membershipId   String           @map("membership_id")
  type           NotificationType
  emailEnabled   Boolean          @default(true) @map("email_enabled")
  inAppEnabled   Boolean          @default(true) @map("in_app_enabled")
  pushEnabled    Boolean          @default(false) @map("push_enabled")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, type])
  @@map("notification_preferences")
}

/// B1.08: the account-stored half of a member's preferences. Text columns are
/// validated against the catalogue in `src/preferences/catalogue.ts`; device-only
/// settings (text size, bolder text, higher contrast, reduce motion) are not stored.
model UserPreference {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  membershipId    String    @map("membership_id")
  /// null = follow the organisation's default look.
  theme           String?
  pageColour      String?   @map("page_colour")
  toggleLightPage String    @default("WHITE") @map("toggle_light_page")
  toggleDarkPage  String    @default("DARK") @map("toggle_dark_page")
  density         String    @default("COMFORTABLE")
  startPage       String?   @map("start_page")
  sidebar         Json      @default("{\"collapsed\":false,\"hidden\":[]}")
  hourFormat      String    @default("H12") @map("hour_format")
  firstDayOfWeek  String    @default("MON") @map("first_day_of_week")
  dateFormat      String    @default("DMY") @map("date_format")
  ownColours      Json?     @map("own_colours")
  undoSnapshot    Json?     @map("undo_snapshot")
  undoTokenHash   String?   @map("undo_token_hash")
  undoExpiresAt   DateTime? @map("undo_expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@map("user_preferences")
}

/// B1.11: quiet hours and the daily email cap, per member. Absence of a row
/// means the defaults (quiet hours off, cap 20).
model NotificationSetting {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  membershipId      String   @map("membership_id")
  quietHoursEnabled Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String   @default("20:00") @map("quiet_hours_start")
  quietHoursEnd     String   @default("07:00") @map("quiet_hours_end")
  dailyEmailCap     Int      @default(20) @map("daily_email_cap")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// 2. Controlled reference data (organization-scoped)
// ---------------------------------------------------------------------------

model LeadSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads           Lead[]
  assignmentRules WebsiteLeadAssignmentRule[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lead_sources")
}

/// Kept separate from Lead Temperature (a fixed HOT/WARM/COLD enum) and
/// from Deal Pipeline Stage / Customer Lifecycle State.
model LeadStatus {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lead_statuses")
}

/// Deal pipeline stage — kept strictly separate from Lead Status and
/// Customer Lifecycle State. A Deal only exists once a Lead has qualified,
/// so this catalog covers the deal side of the funnel (Solution Presented
/// -> ... -> Closed Won/Lost). See IMPLEMENTATION_NOTES.md for where the
/// lead/deal split happens.
model PipelineStage {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  key              String
  name             String
  description      String?
  sequence         Int      @default(0)
  probability      Int?
  /// Days without activity after which an open deal in this stage counts as stalled; null uses the organisation default (FIG-1035).
  stalledAfterDays Int?     @map("stalled_after_days")
  isWon            Boolean  @default(false) @map("is_won")
  isLost           Boolean  @default(false) @map("is_lost")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("pipeline_stages")
}

/// Lifecycle state applies at the Company (account) level — Company is the
/// canonical account identity, not a separate `customers` table; lifecycle
/// is just one of its attributes.
model CustomerLifecycleState {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies    Company[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("customer_lifecycle_states")
}

/// Shared catalog of lost/disqualification reasons, referenced by both
/// Lead and Deal.
model LostReason {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("lost_reasons")
}

/// FigBloom's own service/product catalog (Web Dev, Branding, CCTV,
/// Starlink/Internet, HR automation, etc).
model Service {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  category       String?
  description    String?
  sequence       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads             Lead[]
  deals             Deal[]
  companyServices   CompanyService[]
  recurringServices RecurringService[]
  assignmentRules   WebsiteLeadAssignmentRule[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("services")
}

// ---------------------------------------------------------------------------
// 3. Core CRM records
// ---------------------------------------------------------------------------

/// The CRM's canonical business/account entity. Duplicate company names
/// are legitimate, so no uniqueness is enforced on name — duplicate
/// detection is an application-level concern informed by the
/// name/email/phone indexes below.
model Company {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  name                   String
  industry               String?
  website                String?
  location               String?
  phone                  String?
  email                  String?
  notes                  String?
  lifecycleStateId       String?   @map("lifecycle_state_id")
  ownerMembershipId      String?   @map("owner_membership_id")
  createdByMembershipId  String?   @map("created_by_membership_id")
  /// Soft-delete (FIG-601) -- excluded from default list/duplicate queries
  /// when set, but never physically removed; see `companyService.ts`'s
  /// archive/restore functions and IMPLEMENTATION_NOTES.md.
  archivedAt             DateTime? @map("archived_at")
  archivedByMembershipId String?   @map("archived_by_membership_id")
  archiveReason          String?   @map("archive_reason")
  /// Organisation-defined custom field values, keyed by field key (FIG-803). A lead's qualification answers are in `qualificationData`.
  customFields           Json      @default("{}") @map("custom_fields")
  /// Rules-based customer health 0-100 and the factors behind it (FIG-1032).
  healthValue            Int?      @map("health_value")
  healthBand             String?   @map("health_band")
  healthFactors          Json?     @map("health_factors")
  healthScoredAt         DateTime? @map("health_scored_at")
  /// When the lifecycle state last changed, and whether a person set it by hand (the daily job leaves a hand-set state alone) (FIG-1048).
  lifecycleChangedAt     DateTime? @map("lifecycle_changed_at")
  lifecycleManual        Boolean   @default(false) @map("lifecycle_manual")
  /// Set when this row was the "loser" of a merge (FIG-601) -- always
  /// archived at the same time. Points at the surviving Company so a
  /// visitor landing on the old record's page can be redirected/shown
  /// where its history went.
  mergedIntoId           String?   @map("merged_into_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lifecycleState CustomerLifecycleState? @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
  owner          Membership?             @relation("CompanyOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy      Membership?             @relation("CompanyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  mergedInto     Company?                @relation("CompanyMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom     Company[]               @relation("CompanyMergedInto")

  contacts        Contact[]
  leads           Lead[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  communications  Communication[]
  companyServices CompanyService[]

  invoices          Invoice[]
  recurringServices RecurringService[]
  lifecycleEvents   LifecycleEvent[]

  tagLinks TagLink[]

  attachments     Attachment[]
  comments        Comment[]
  follows         RecordFollow[]
  /// B4.04: the import session that created this row (null for rows made any other way).
  importSessionId String?        @map("import_session_id")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, lifecycleStateId])
  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, archivedAt])
  @@map("companies")
}

/// A person, distinct from Company. A contact with no company is
/// supported (e.g. an individual lead with no business behind them yet).
model Contact {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  companyId              String?   @map("company_id")
  firstName              String    @map("first_name")
  lastName               String?   @map("last_name")
  phone                  String?
  email                  String?
  jobTitle               String?   @map("job_title")
  department             String?
  socialProfiles         Json?     @map("social_profiles")
  notes                  String?
  ownerMembershipId      String?   @map("owner_membership_id")
  createdByMembershipId  String?   @map("created_by_membership_id")
  /// Soft-delete (FIG-601) -- see Company.archivedAt's doc comment.
  archivedAt             DateTime? @map("archived_at")
  archivedByMembershipId String?   @map("archived_by_membership_id")
  archiveReason          String?   @map("archive_reason")
  /// Organisation-defined custom field values, keyed by field key (FIG-803). A lead's qualification answers are in `qualificationData`.
  customFields           Json      @default("{}") @map("custom_fields")
  /// Set when this row was the "loser" of a merge (FIG-601) -- see
  /// Company.mergedIntoId's doc comment.
  mergedIntoId           String?   @map("merged_into_id")
  /// Set by quick-log (FIG-1054) when a call or WhatsApp message to this person was logged.
  lastContactedAt        DateTime? @map("last_contacted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        Membership?  @relation("ContactOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy    Membership?  @relation("ContactCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  mergedInto   Contact?     @relation("ContactMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Contact[]    @relation("ContactMergedInto")

  leads          Lead[]
  dealsAsPrimary Deal[]          @relation("DealPrimaryContact")
  activities     Activity[]
  tasks          Task[]
  communications Communication[]

  tagLinks TagLink[]

  attachments     Attachment[]
  comments        Comment[]
  follows         RecordFollow[]
  /// B4.04: the import session that created this row (null for rows made any other way).
  importSessionId String?        @map("import_session_id")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, archivedAt])
  @@map("contacts")
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

/// A prospect before/during qualification. Lead Status, Temperature, and
/// Source are independent classifications. `qualificationData` holds
/// service-specific qualification questions (e.g. property/internet
/// details) without needing a full custom-fields subsystem.
model Lead {
  id                     String          @id @default(uuid())
  organizationId         String          @map("organization_id")
  companyId              String?         @map("company_id")
  contactId              String?         @map("contact_id")
  leadSourceId           String?         @map("lead_source_id")
  leadStatusId           String          @map("lead_status_id")
  temperature            LeadTemperature @default(WARM)
  serviceInterestId      String?         @map("service_interest_id")
  ownerMembershipId      String?         @map("owner_membership_id")
  qualificationData      Json?           @map("qualification_data")
  lostReasonId           String?         @map("lost_reason_id")
  nextFollowUpAt         DateTime?       @map("next_follow_up_at")
  convertedAt            DateTime?       @map("converted_at")
  notes                  String?
  createdByMembershipId  String?         @map("created_by_membership_id")
  /// Soft-delete (FIG-601) -- see Company.archivedAt's doc comment.
  archivedAt             DateTime?       @map("archived_at")
  archivedByMembershipId String?         @map("archived_by_membership_id")
  archiveReason          String?         @map("archive_reason")
  /// Organisation-defined custom field values, keyed by field key (FIG-803). A lead's qualification answers are in `qualificationData`.
  customFields           Json            @default("{}") @map("custom_fields")
  /// Rules-based lead score 0-100 and the factors behind it (FIG-1032); see docs/SCORING.md.
  scoreValue             Int?            @map("score_value")
  scoreBand              String?         @map("score_band")
  scoreFactors           Json?           @map("score_factors")
  scoredAt               DateTime?       @map("scored_at")
  /// Set by quick-log (FIG-1054) when a call or WhatsApp message about this lead was logged.
  lastContactedAt        DateTime?       @map("last_contacted_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadSource      LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  leadStatus      LeadStatus   @relation(fields: [leadStatusId], references: [id], onDelete: Restrict)
  serviceInterest Service?     @relation(fields: [serviceInterestId], references: [id], onDelete: SetNull)
  owner           Membership?  @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  createdBy       Membership?  @relation("LeadCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  lostReason      LostReason?  @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  communications Communication[]

  tagLinks TagLink[]

  attachments Attachment[]

  poolRequests    LeadPoolRequest[]
  comments        Comment[]
  follows         RecordFollow[]
  /// B4.04: the import session that created this row (null for rows made any other way).
  importSessionId String?           @map("import_session_id")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, leadStatusId])
  @@index([organizationId, leadSourceId])
  @@index([organizationId, temperature])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, companyId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, archivedAt])
  /// Lead volume/conversion reporting (FIG-603) filters leads by
  /// organizationId + a createdAt range, and separately counts by
  /// convertedAt IS NOT NULL -- neither was covered by an existing index.
  @@index([organizationId, createdAt])
  @@index([organizationId, convertedAt])
  @@map("leads")
}

enum DealOutcome {
  OPEN
  WON
  LOST
}

/// A sales opportunity with its own Pipeline Stage, kept strictly separate
/// from Lead Status and Customer Lifecycle State. The unique
/// (organizationId, leadId) constraint stops a single Lead from being
/// converted into more than one Deal, while still allowing many Deals with
/// no originating Lead (leadId null — e.g. an existing-customer upsell).
model Deal {
  id                     String      @id @default(uuid())
  organizationId         String      @map("organization_id")
  companyId              String      @map("company_id")
  primaryContactId       String?     @map("primary_contact_id")
  leadId                 String?     @map("lead_id")
  serviceId              String?     @map("service_id")
  ownerMembershipId      String      @map("owner_membership_id")
  pipelineStageId        String      @map("pipeline_stage_id")
  value                  Decimal?    @db.Decimal(14, 2)
  currency               String      @default("KES")
  expectedCloseDate      DateTime?   @map("expected_close_date") @db.Date
  outcome                DealOutcome @default(OPEN)
  lostReasonId           String?     @map("lost_reason_id")
  wonAt                  DateTime?   @map("won_at")
  lostAt                 DateTime?   @map("lost_at")
  notes                  String?
  createdByMembershipId  String?     @map("created_by_membership_id")
  /// Soft-delete (FIG-601) -- see Company.archivedAt's doc comment.
  archivedAt             DateTime?   @map("archived_at")
  archivedByMembershipId String?     @map("archived_by_membership_id")
  archiveReason          String?     @map("archive_reason")
  /// Organisation-defined custom field values, keyed by field key (FIG-803). A lead's qualification answers are in `qualificationData`.
  customFields           Json        @default("{}") @map("custom_fields")
  /// When anything last happened on the deal (activity, email, stage move); stalled is derived from it (FIG-1035).
  lastActivityAt         DateTime    @default(now()) @map("last_activity_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact Contact?      @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  owner          Membership    @relation("DealOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  createdBy      Membership?   @relation("DealCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  pipelineStage  PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  lostReason     LostReason?   @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  activities         Activity[]
  tasks              Task[]
  communications     Communication[]
  proposalReferences ProposalReference[]
  handoff            DealHandoff?
  invoices           Invoice[]
  paymentNotes       DealPaymentNote[]

  tagLinks TagLink[]

  attachments Attachment[]

  moves           DealMove[]
  comments        Comment[]
  follows         RecordFollow[]
  /// B4.04: the import session that created this row (null for rows made any other way).
  importSessionId String?        @map("import_session_id")

  @@unique([organizationId, id])
  @@unique([organizationId, leadId])
  @@index([organizationId])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, companyId])
  @@index([organizationId, outcome])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, archivedAt])
  /// Won/lost and sales-by-service reporting (FIG-603) filter by outcome
  /// plus a wonAt/lostAt range, and group by serviceId -- none of which
  /// the existing indexes above cover.
  @@index([organizationId, outcome, wonAt])
  @@index([organizationId, outcome, lostAt])
  @@index([organizationId, serviceId])
  @@map("deals")
}

