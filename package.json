{
  "name": "figbloom-crm",
  "version": "0.1.0",
  "private": true,
  "description": "FigBloom Digital Group CRM — core data model and database foundation (FIG-438)",
  "type": "commonjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "db:bootstrap-role": "tsx scripts/db-admin.ts bootstrap-role",
    "db:grant-role": "tsx scripts/db-admin.ts grant-role",
    "db:setup": "npm run migrate:deploy && npm run db:bootstrap-role && npm run db:grant-role && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
