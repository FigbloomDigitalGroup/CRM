        "src/services/stalledDealAlerts.ts",
        "src/services/supportAccessService.ts",
        "src/services/supportRequestService.ts",
        "src/services/syncService.ts",
        "src/services/taskBackfill.ts",
        "src/services/teamActivityNotifier.ts",
        "src/services/twoStepService.ts",
        "src/services/twoStepSignInService.ts",
        "src/services/websiteLeadAssignmentRuleService.ts",
        "src/services/websiteLeadService.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/db/adminClient"
                ],
                "message": "adminDb is the schema-owner client: it bypasses row-level security. New code reads and writes tenant data through withOrgContext (src/db/orgScopedClient.ts). A file that truly needs the owner connection (identity, bootstrap, platform, cron claim) is added to config/adminDbAllowList.json and to this list after review. See docs/ADMINDB_RULE.md (UC-F4)."
              }
            ]
          }
        ]
      }
    }
  ]
}
