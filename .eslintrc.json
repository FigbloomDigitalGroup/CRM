{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "prisma/migrations",
    ".next",
    "next-env.d.ts"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "off"
  },
  "overrides": [
    {
      "files": [
        "src/app/**/*.ts",
        "src/app/**/*.tsx",
        "src/ui/**/*.ts",
        "src/ui/**/*.tsx"
      ],
      "excludedFiles": [
        "src/app/api/**",
        "src/ui/data/client.ts",
        "src/app/accept-invite/AcceptInviteForm.tsx",
        "src/app/dev-sentry-test/SentryTestButtons.tsx",
        "src/app/forgot-password/ForgotPasswordForm.tsx",
        "src/app/login/LoginForm.tsx",
        "src/app/o/[[]orgSlug[]]/_shared/ArchiveControl.tsx",
        "src/app/o/[[]orgSlug[]]/_shared/MergeControl.tsx",
        "src/app/o/[[]orgSlug[]]/_shared/TaskSection.tsx",
        "src/app/o/[[]orgSlug[]]/settings/CatalogEditor.tsx",
        "src/app/platform/PlatformSignOut.tsx",
        "src/app/reset-password/ResetPasswordForm.tsx",
        "src/app/signup/SignupForm.tsx"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Screens do not call fetch. Use the typed client through the hooks in @/ui (useApiQuery, useApiMutation). See src/ui/data/hooks.tsx (F1.06)."
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "excludedFiles": [
        "src/app/_dev/renderDevChips.tsx",
        "src/app/api/dev-session/route.ts",
        "src/app/api/health/route.ts",
        "src/app/api/orgs/[[]orgSlug[]]/deals/route.ts",
        "src/app/api/public/inbound/mailgun/route.ts",
        "src/app/login/page.tsx",
        "src/auth/apiToken.ts",
        "src/auth/devAccountGuard.ts",
        "src/auth/inboundBccAddress.ts",
        "src/auth/inboundEmailKey.ts",
        "src/auth/loginThrottle.ts",
        "src/auth/passwordResetToken.ts",
        "src/auth/platformIdentity.ts",
        "src/auth/rateLimiter.ts",
        "src/auth/requestContext.ts",
        "src/auth/session.ts",
        "src/auth/sessionPolicy.ts",
        "src/auth/twoStep/stores.ts",
        "src/auth/websiteApiKey.ts",
        "src/automations/runLog.ts",
        "src/jobs/runner.ts",
        "src/lib/apiErrors.ts",
        "src/lib/featureConfig.ts",
        "src/notifications/webPush.ts",
