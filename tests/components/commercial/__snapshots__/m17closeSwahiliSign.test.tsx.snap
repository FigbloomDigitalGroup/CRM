// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the live signing page per language > snapshot: English 1`] = `"<main class="sgn__wrap" lang="en" data-screen-label="Client e-signature"><div class="sgn__bar"><span class="sgn__brand">Figbloom Digital</span><div class="sgn__lang" role="group" aria-label="Language"><button type="button" aria-pressed="true">EN</button><button type="button" aria-pressed="false" lang="sw">SW</button></div></div><section class="sgn__card" aria-labelledby="sgn-title"><h1 class="sgn__h1" id="sgn-title">Quote Q-2026-0001</h1><p class="sgn__muted">Prepared for Mwangaza Schools · Valid until 4 December 2026</p><table class="sgn__table"><thead><tr><th scope="col">Item</th><th scope="col" class="sgn__num">Qty</th><th scope="col" class="sgn__num">Amount</th></tr></thead><tbody><tr><td>CCTV camera</td><td class="sgn__num">2</td><td class="sgn__num">KES 37,000.00</td></tr></tbody></table><div class="sgn__muted" style="display: flex; justify-content: space-between;"><span>Subtotal</span><span>KES 37,000.00</span></div><div class="sgn__muted" style="display: flex; justify-content: space-between;"><span>Discount (10%)</span><span>−KES 3,700.00</span></div><div class="sgn__total"><span>Total (incl. VAT)</span><span>KES 33,300.00</span></div><p class="sgn__muted">50% deposit.</p></section><form class="sgn__card" novalidate=""><label class="sgn__label">Your full name<input class="sgn__input" autocomplete="name" maxlength="200" value=""></label><div class="sgn__sig" aria-hidden="true"></div><label class="sgn__label">Your email address (optional)<input class="sgn__input" autocomplete="email" maxlength="320" type="email" value=""></label><label class="sgn__check"><input type="checkbox"> <span>I agree to the scope, prices and terms in this quote, and I accept that typing my name is my signature.</span></label><button class="sgn__btn" type="submit">Sign and accept</button></form></main>"`;

exports[`the live signing page per language > snapshot: Swahili 1`] = `"<main class="sgn__wrap" lang="sw" data-screen-label="Client e-signature"><div class="sgn__bar"><span class="sgn__brand">Figbloom Digital</span><div class="sgn__lang" role="group" aria-label="Lugha"><button type="button" aria-pressed="false">EN</button><button type="button" aria-pressed="true" lang="sw">SW</button></div></div><section class="sgn__card" aria-labelledby="sgn-title"><h1 class="sgn__h1" id="sgn-title">Makadirio ya bei Q-2026-0001</h1><p class="sgn__muted">Imeandaliwa kwa Mwangaza Schools · Inatumika hadi 4 Desemba 2026</p><table class="sgn__table"><thead><tr><th scope="col">Huduma</th><th scope="col" class="sgn__num">Idadi</th><th scope="col" class="sgn__num">Kiasi</th></tr></thead><tbody><tr><td>CCTV camera</td><td class="sgn__num">2</td><td class="sgn__num">KES 37,000.00</td></tr></tbody></table><div class="sgn__muted" style="display: flex; justify-content: space-between;"><span>Jumla ndogo</span><span>KES 37,000.00</span></div><div class="sgn__muted" style="display: flex; justify-content: space-between;"><span>Punguzo (10%)</span><span>−KES 3,700.00</span></div><div class="sgn__total"><span>Jumla (pamoja na VAT)</span><span>KES 33,300.00</span></div><p class="sgn__muted">50% deposit.</p></section><form class="sgn__card" novalidate=""><label class="sgn__label">Jina lako kamili<input class="sgn__input" autocomplete="name" maxlength="200" value=""></label><div class="sgn__sig" aria-hidden="true"></div><label class="sgn__label">Barua pepe yako (si lazima)<input class="sgn__input" autocomplete="email" maxlength="320" type="email" value=""></label><label class="sgn__check"><input type="checkbox"> <span>Nakubali huduma, bei na masharti yaliyomo kwenye makadirio haya, na ninakubali kwamba kuandika jina langu ni sahihi yangu.</span></label><button class="sgn__btn" type="submit">Saini na ukubali</button></form></main>"`;

exports[`the live signing page per language > snapshot: expired link, Swahili 1`] = `"<main class="sgn__wrap" lang="sw"><div class="sgn__bar"><span class="sgn__brand">Figbloom Digital</span><div class="sgn__lang" role="group" aria-label="Lugha"><button type="button" aria-pressed="false">EN</button><button type="button" aria-pressed="true" lang="sw">SW</button></div></div><div class="sgn__card" role="alert"><h1 class="sgn__h1">Kiungo hiki kimeisha muda</h1><p class="sgn__muted">Mwombe Figbloom Digital akutumie kiungo kipya.</p></div></main>"`;
