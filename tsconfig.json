{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next-dev/types/**/*.ts",
    ".next-e2e-demo/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-plain/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-qa-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e",
    "next-env.d.ts",
    "playwright.config.ts",
    "prisma",
    "scripts",
    "src",
    "tests",
    "vitest.config.ts",
    ".next-e2e-cleanup/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
