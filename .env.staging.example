# Staging environment template (FIG-1123, P1.01). See docs/STAGING.md.
# Copy the NAMES into the host's secret store. Never commit a filled-in copy.
# Every value below is a placeholder. Staging and production must have their own, independently generated secrets.

# --- Identity of this environment (the staging scripts refuse to run without it) ---
NODE_ENV="production"                  # same image and mode as production
FIGBLOOM_ENVIRONMENT="staging"         # production sets "production"
# ALLOW_DEV_ACCOUNTS must be UNSET on staging (CLAUDE.md rule 10). Do not add DEV_SESSION_SECRET either.
ACTIVE_RELEASE="v1"
APP_BASE_URL="https://<staging host>"  # also the allowed origin for the CSRF check

# --- Database (database name must contain "staging") ---
# Schema owner: migrations, role steps, refresh, seed. Never used for requests at runtime.
DATABASE_URL="postgresql://<owner>:<password>@<host>:5432/figbloom_crm_staging?schema=public"
# Application role (figbloom_app), what the running app uses.
APP_DATABASE_URL="postgresql://figbloom_app:<app password>@<host>:5432/figbloom_crm_staging?schema=public"
APP_DB_PASSWORD="<generate>"
# db-admin.ts grants CONNECT on these. It defaults to the dev and test names, so it MUST be set here.
APP_DB_NAMES="figbloom_crm_staging"
# Tripwire only, normally left UNSET on staging. If set, the staging scripts refuse to touch that database.
# PRODUCTION_DATABASE_URL=""

# --- Email: a sandbox only, never a real provider ---
SMTP_HOST="<sandbox host, e.g. a Mailpit or Mailtrap inbox>"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<sandbox user>"
SMTP_PASS="<sandbox password>"
SMTP_FROM="FigBloom CRM Staging <no-reply@staging.example.com>"

# --- Files: a separate private bucket from production ---
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://<storage endpoint>"
# Optional: the address browsers use, when it differs from the one the server uses.
# S3_PUBLIC_ENDPOINT="https://<browser-facing storage endpoint>"
S3_REGION="<region>"
S3_BUCKET="figbloom-crm-staging"
S3_ACCESS_KEY_ID="<staging-only key>"
S3_SECRET_ACCESS_KEY="<staging-only secret>"
S3_FORCE_PATH_STYLE="true"
CLAMD_HOST="<antivirus host>"          # FIG-1257: uploads are really scanned
CLAMD_PORT="3310"

# --- Jobs ---
CRON_SECRET="<generate>"               # for /api/cron/notifications-sweep

# --- Error tracking (optional, DSN is not a secret) ---
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ENVIRONMENT="staging"

# --- Used only by the staging scripts, supplied at run time, never stored in the image ---
# STAGING_UAT_PASSWORD="<from the secret store, 14+ characters>"   # scripts/staging-seed.ts and staging-smoke.ts
# STAGING_REFRESH_CONFIRM="figbloom_crm_staging"                   # scripts/staging-refresh.ts anonymise --yes
# STAGING_URL="https://<staging host>"                             # scripts/staging-smoke.ts
# STAGING_ORG_SLUG="figbloom"

# --- Observability (FIG-1124, docs/OBSERVABILITY.md) ---
# Bearer/x-metrics-token for GET /api/metrics. Unset means the route answers 404. Use a long random value from the secret store.
METRICS_TOKEN="<generate>"
