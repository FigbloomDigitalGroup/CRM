# Copy this file to .env and adjust as needed for local development.
# NEVER commit a real .env file -- it is gitignored on purpose.

# Administrative connection (schema owner / superuser in local dev). Used by
# Prisma CLI (migrate, seed) and by scripts/db-admin.ts to provision the
# least-privilege application role below. Never used by application code at
# runtime.
DATABASE_URL="postgresql://figbloom:figbloom@localhost:55432/figbloom_crm_dev?schema=public"

# Same, but for the isolated database used only by the automated test suite.
TEST_DATABASE_URL="postgresql://figbloom:figbloom@localhost:55432/figbloom_crm_test?schema=public"

# Password for the dedicated, least-privilege "figbloom_app" Postgres role
# that the application (and RLS-dependent tests) connect as. Row-level
# security has no effect on the table owner/superuser, so this role is what
# actually makes tenant isolation enforceable at the database level -- see
# prisma/migrations/*_tenant_integrity_and_rls and README.md.
#
# Set this to any local value for development; in staging/production it
# must come from a secret manager, never from a committed file.
APP_DB_PASSWORD="figbloom_app_local_dev_only"

# Connection strings using the app role above (created by
# `npm run db:bootstrap-role`). Used by the org-scoped data-access layer
# (src/db/orgScopedClient.ts) and by the tenant-isolation test suite.
APP_DATABASE_URL="postgresql://figbloom_app:figbloom_app_local_dev_only@localhost:55432/figbloom_crm_dev?schema=public"
TEST_APP_DATABASE_URL="postgresql://figbloom_app:figbloom_app_local_dev_only@localhost:55432/figbloom_crm_test?schema=public"

# FIG-1135 (B6.03): the dedicated platform database role "figbloom_platform".
# It can touch only platform_identities, platform_sessions and the
# platform_organization_counts view, never a tenant table. Platform sign-in
# needs both values; without them the platform session code fails closed.
# (The test run derives its own URL from TEST_DATABASE_URL if
# TEST_PLATFORM_DATABASE_URL is not set.)
PLATFORM_DB_PASSWORD="figbloom_platform_local_dev_only"
PLATFORM_DATABASE_URL="postgresql://figbloom_platform:figbloom_platform_local_dev_only@localhost:55432/figbloom_crm_dev?schema=public"
TEST_PLATFORM_DATABASE_URL="postgresql://figbloom_platform:figbloom_platform_local_dev_only@localhost:55432/figbloom_crm_test?schema=public"

# Signs the dev-login placeholder cookie (src/auth/devSession.ts). This is
# NOT real authentication -- see that file's header comment. Any local
# value works; rotate it in every real environment via a secret manager,
# never a committed file.
DEV_SESSION_SECRET="figbloom_dev_session_local_only"

# Optional: set to "true" to hide the seeded @figbloom.local "Dev accounts"
# quick-login list on /login (src/app/login/page.tsx). Useful when running
# `next dev` for a demo/stakeholder walkthrough instead of a production
# build -- NODE_ENV is still "development" in that case, so this is the
# only way to suppress the list without a full prod build.
# HIDE_DEV_LOGIN_ACCOUNTS="true"

# Optional: real SMTP delivery for password-reset emails (src/auth/email.ts,
# FIG-592). Leave SMTP_HOST unset for local development -- the reset link
# is logged to the server console instead, so the flow stays testable
# without credentials. Once a real provider is available, set all of these
# (SMTP_PASS from a secret manager, never a committed file) and email
# sending switches on with no code change.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey"
# SMTP_PASS=""
# SMTP_FROM="FigBloom CRM <no-reply@figbloom.local>"
# Or send through Resend (MVP-11): with RESEND_API_KEY set and SMTP_HOST unset, invites, password resets, notifications and quotes go through the
# Resend API. EMAIL_FROM must be an address on a domain verified in Resend. In production with neither provider the app logs an ERROR at boot and
# /api/health shows email "misconfigured". RESEND_API_KEY is shared with support requests below (secret manager only).
# EMAIL_FROM="FigBloom CRM <no-reply@mail.example.com>"

# Number of trusted reverse proxies in front of the app. When set, the client IP is the X-Forwarded-For entry
# that many places from the right; when unset X-Forwarded-For is ignored and X-Real-IP is used (docs/DEPLOYMENT.md).
# TRUSTED_PROXY_HOPS="1"

# Optional: tune the public website lead-capture endpoint's rate limits
# (src/services/websiteLeadService.ts, FIG-594). Sane defaults (60s window,
# 20/window per IP, 60/window per key) apply if unset. Counts against the
# same shared, durable store as the login/signup/password-reset limits
# below (src/auth/rateLimiter.ts, FIG-784), not an in-process counter.
# WEBSITE_LEAD_RATE_LIMIT_WINDOW_MS="60000"
# WEBSITE_LEAD_RATE_LIMIT_MAX_PER_IP="20"
# WEBSITE_LEAD_RATE_LIMIT_MAX_PER_KEY="60"

# Optional: tune login/signup/password-reset rate limiting (FIG-784 --
# see docs/DEPLOYMENT.md). Durable and cross-instance (Postgres, not
# in-process memory), so these are safe to leave at their defaults across
# multiple replicas. Each action's window/per-IP/per-email limits default
# to the values shown (commented out) if unset -- set these to match your
# real-world traffic, or shrink WINDOW_MS/the max values in a test to prove
# the limiting works without firing dozens of real requests.
# Sign-in (P2-02): growing wait per IP+email pair, high ceilings, never a lock-out
# of a real person. Only FAILED attempts count. See docs/SIGN_IN_RATE_LIMIT.md.
# LOGIN_RATE_LIMIT_WINDOW_MS="3600000"   # window of the two ceilings
# LOGIN_RATE_LIMIT_MAX_PER_IP="300"      # failures per address per window: hard block until it passes
# LOGIN_RATE_LIMIT_MAX_PER_EMAIL="200"   # failures per email, all addresses: longest wait + security event, no block
# LOGIN_DELAY_WINDOW_MS="900000"         # how long a pair's failures count toward the growing wait
# LOGIN_DELAY_FREE_ATTEMPTS="3"          # failures before any wait
# LOGIN_DELAY_BASE_SECONDS="1"           # first wait; doubles each failure
# LOGIN_DELAY_MAX_SECONDS="30"           # longest wait
# SIGNUP_RATE_LIMIT_WINDOW_MS="3600000"
# SIGNUP_RATE_LIMIT_MAX_PER_IP="10"
# SIGNUP_RATE_LIMIT_MAX_PER_EMAIL="3"
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MS="3600000"
# PASSWORD_RESET_RATE_LIMIT_MAX_PER_IP="10"
# PASSWORD_RESET_RATE_LIMIT_MAX_PER_PAIR="3"    # per IP + email pair (P2-02)
# PASSWORD_RESET_RATE_LIMIT_MAX_PER_EMAIL="30"  # per email, all addresses: only stops mail flooding

# Optional: hard ceiling on rows processed per CSV import call
# (src/services/importService.ts, FIG-596). The file is streamed row-by-row
# regardless of size, so this isn't a memory limit -- it's the backstop
# against a single runaway request, since this project has no job queue to
# hand very large imports off to. Defaults to 20000 if unset.
# IMPORT_MAX_ROWS="20000"

# Base URL used to build links inside notification emails (FIG-597) --
# e.g. "https://crm.figbloom.com" in production. Unlike the password-reset/
# invite links (built from the inbound request's own origin), notifications
# can be generated with no HTTP request in scope at all (the due/overdue
# sweep script runs on a timer, not in response to a request), so this is a
# real env var rather than derived per-request. Defaults to
# "http://localhost:3000" if unset, which is correct for local dev.
# APP_BASE_URL="http://localhost:3000"

# Optional (required to trigger it externally): shared secret for
# GET /api/cron/notifications-sweep (FIG-783 -- see docs/DEPLOYMENT.md's
# "Scheduled jobs" section). The route refuses to run at all if this is
# unset, so it's safe to leave unset in local dev/CI; set it to a real
# random value per environment in staging/production and pass it as
# "Authorization: Bearer <value>" or "X-Cron-Secret: <value>" from
# whatever external cron/scheduler calls that route.
# CRON_SECRET=""

# Optional: how often the notifications due/overdue sweep is allowed to
# actually run (FIG-783). Defaults to 15 (minutes) if unset. This does NOT
# schedule anything by itself -- it's a self-throttle/stale-lock-timeout
# the sweep applies to itself (src/services/notificationSweepService.ts),
# so set it to match whatever interval you configure your external
# cron/scheduler with.
# NOTIFICATIONS_SWEEP_INTERVAL_MINUTES="15"

# Optional: a real SMS/WhatsApp provider for notification delivery
# (src/notifications/sms.ts, FIG-597 AC: "SMS/WhatsApp optional"). No
# provider account exists for this project, so this is unset by default --
# every SMS send logs instead of reaching a phone, same documented-gap
# pattern as SMTP before a real server is configured. Setting this alone
# does nothing useful yet; see that file's header comment for why.
# SMS_PROVIDER_API_KEY=""

# Optional: error tracking (Sentry, FIG-753 -- see docs/DEPLOYMENT.md).
# Leave unset for local dev/CI -- both the client and server Sentry init
# (src/instrumentation-client.ts, src/instrumentation.ts) and the pino
# logger's Sentry bridge (src/lib/logger.ts) are complete no-ops without a
# DSN, so nothing here is required to run this app. A DSN is not a secret
# by Sentry's own design (safe to ship to the browser), which is why this
# is a single var reused by both the client and server init rather than a
# separate NEXT_PUBLIC_/server-only pair.
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_ENVIRONMENT="production"

# Optional, build-time only: lets the Next.js build upload real source maps
# to Sentry so a stack trace shows actual source instead of minified build
# output. All three are read directly from the environment by the
# underlying bundler plugin -- nothing else in this repo needs to reference
# them. Omit SENTRY_AUTH_TOKEN (e.g. in local dev) and the upload step is
# automatically skipped; the app and its own error reporting are
# unaffected either way.
# SENTRY_ORG="figbloom"
# SENTRY_PROJECT="figbloom-crm"
# SENTRY_AUTH_TOKEN=""

# Which release this deployment is running (FIG-1015, B0.07): v1, v1.1 or v2.
# Features tagged for a later release stay hidden and answer "not available
# yet". Unset means v1. An organization can be moved ahead of the rest by a
# platform operator (see docs/FEATURE_FLAGS.md).
# ACTIVE_RELEASE="v1"

# Confirms this is a development database, so `npm run seed:dev` (and `npm run
# db:setup`) may create the dev accounts and sample data. Never set in production;
# the dev seed also refuses to run when NODE_ENV=production (FIG-1016).
ALLOW_DEV_ACCOUNTS="true"

# File storage (src/storage, FIG-1023). Local development needs nothing: files
# go under .data/files and links are signed with DEV_SESSION_SECRET. In
# production set STORAGE_DRIVER=s3 and the S3_* values (from a secret manager,
# never a committed file); local-disk links then do not exist at all.
# STORAGE_DRIVER="local"          # or "s3"; required in production
# STORAGE_LOCAL_DIR=".data/files"
# STORAGE_SIGNING_SECRET=""        # required for the local driver in production
# S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
# S3_REGION="eu-west-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"       # "false" for virtual-hosted style
# Optional malware scanning with ClamAV (clamd). Unset: only the built-in
# EICAR test detector runs. Any scan error fails closed (file not served).
# CLAMD_HOST=""   # production boot needs this unless ANTIVIRUS_MODE=builtin-only (below)
# CLAMD_PORT="3310"

# Sign-in protection and the app shell (Stage 1). All optional; defaults shown.
# LOCKOUT_MAX_FAILURES="200"          # failures in a row before the account only gets the longest wait (never a lock-out, P2-02)
# LOCKOUT_DURATION_MS="900000"        # 15 minutes
# INVITE_RESEND_COOLDOWN_MS="60000"   # brake on re-sending the same pending invite
# ME_CONTEXT_CACHE_MS="15000"         # /api/me/context cache per person; 0 turns it off

# Two-step sign-in (FIG-1134): 32 random bytes, base64. Required in production; a dev-only fallback key is used elsewhere.
# TWO_STEP_ENCRYPTION_KEY=""
# TWO_STEP_RATE_LIMIT_MAX_PER_USER="10"   # code attempts per account per window
# TWO_STEP_RATE_LIMIT_MAX_PER_IP="30"

# FIG-1153 / FIG-807 / FIG-808 (M13): email and calendar connections. All values come from a secret manager in every real
# environment; never commit real ones. INTEGRATION_ENCRYPTION_KEY is base64 of 32 random bytes (openssl rand -base64 32); without
# it no token can be stored. Register ${APP_BASE_URL}/api/integrations/oauth/callback as the redirect address with both providers.
# INTEGRATION_ENCRYPTION_KEY=""
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# MICROSOFT_OAUTH_CLIENT_ID=""
# MICROSOFT_OAUTH_CLIENT_SECRET=""
# MICROSOFT_OAUTH_TENANT="common"

# FIG-1152 / FIG-1154 (M13): the assistant and the business-card reader use Claude through @anthropic-ai/sdk (npm install it where
# these are switched on). Without the key the assistant says it is not set up and the card reader falls back to typing.
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-sonnet-5-5"

# M13 go-live additions (see docs/DEPLOYMENT.md). No real values here.
# PLATFORM_DELETION_WAIT_DAYS="30"       # default 30, minimum 7
# TRUSTED_PROXY_HOPS=""                  # number of trusted proxy hops; unset = X-Forwarded-For is ignored
# VAPID_PUBLIC_KEY=""                    # web push; all three needed, else push is disabled
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:ops@example.com"
# PUSH_EXTRA_HOSTS=""                    # comma-separated extra push hosts
# JOBS_POLL_INTERVAL_MS="5000"           # npm run jobs:worker
# MIGRATION_MAX_ROWS="50000"
# MIGRATION_ROLLBACK_WINDOW_HOURS=""
# TWO_STEP_RATE_LIMIT_WINDOW_MS="900000"
# PLATFORM_DB_ROLE="figbloom_platform"
# APP_DB_ROLE="figbloom_app"
# APP_VERSION=""
# SENTRY_ENVIRONMENT=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# FIG-806: BCC-to-CRM through Mailgun routes. MAILGUN_INBOUND_SIGNING_KEY is Mailgun's HTTP webhook signing key (unset means every inbound call
# is refused). INBOUND_EMAIL_DOMAIN is the domain whose MX points at Mailgun (for example inbound.example.com). INBOUND_EMAIL_ADDRESS_SECRET is
# 32+ random characters that make each organisation's address unguessable; set it once, changing it changes every address. See docs/DEPLOYMENT.md.
# MAILGUN_INBOUND_SIGNING_KEY=""
# INBOUND_EMAIL_DOMAIN=""
# INBOUND_EMAIL_ADDRESS_SECRET=""

# Support requests by email (docs/SUPPORT_BY_EMAIL.md, decision 12). A member's "Contact support" request is sent through Resend to Figbloom's
# support inbox, with the member as Reply-To. RESEND_API_KEY comes from Michael once Resend is set up (secret manager only, never a committed file).
# SUPPORT_EMAIL_FROM must use a domain verified in Resend, for example "Figbloom CRM <support-requests@mail.example.com>". SUPPORT_INBOX_EMAIL is the
# address the platform console reads. With any of the three unset, production answers 503 and other environments log the request instead.
# RESEND_API_KEY=""
# SUPPORT_EMAIL_FROM=""
# SUPPORT_INBOX_EMAIL=""

# Vercel MVP (docs/DEPLOYMENT.md "Vercel MVP deployment", docs/DECISIONS.md section 7). Placeholders only; real values live in Vercel.
# Hosted database: DATABASE_URL = owner role, DIRECT (non-pooled) host; APP_DATABASE_URL and PLATFORM_DATABASE_URL = the POOLED host with
# ?sslmode=require&pgbouncer=true&connection_limit=1. DIRECT_URL is read only by `npm run migrate:deploy:direct` (falls back to DATABASE_URL).
# DIRECT_URL="postgresql://owner:password@direct-host.example/figbloom_crm?sslmode=require"
# FIGBLOOM_ENVIRONMENT="production"      # "production" | "staging" | "preview"; switches on the production boot guards
# STORAGE_DRIVER="s3"                    # with the S3_* values above
# Opt-out of the production ClamAV requirement, ONLY with the signed risk acceptance in docs/DECISIONS.md 7.6. Logs a warning at every boot.
# ANTIVIRUS_MODE="builtin-only"
# Never set these in production or preview: ALLOW_DEV_ACCOUNTS, DEMO_SCREENS, NEXT_PUBLIC_DEMO_SCREENS, NEXT_PUBLIC_PREVIEW_CHIPS.
